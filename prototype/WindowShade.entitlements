<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime exceptions for the main app (spec C3). With -o runtime, macOS refuses these
  resources unless the signature declares them; each one matches an Info.plist usage description:
  - apple-events: NSAppleEventsUsageDescription (Music / Spotify fallback, PresenceLockDriver).
  - device.camera: NSCameraUsageDescription (face scan, presence).
  - device.audio-input: NSAudioCaptureUsageDescription (AudioLevelTap process tap).
  - personal-information.calendars: NSCalendarsFullAccessUsageDescription (CalendarSource).
  No library-validation or JIT exceptions: everything loaded in-process is a system framework
  or signed by the same team (Sparkle). MediaRemoteAdapter runs inside /usr/bin/perl, not here.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
