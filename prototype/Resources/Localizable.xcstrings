    "privacy.copy-progress.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only after you turn on this experiment; updates arrive on change, never by polling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你打开这个实验功能之后；进度有变化时才收到，没有轮询"
          }
        }
      }
    },
    "privacy.copy-progress.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filenames of copies together show what you've been organizing; contents stay invisible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝的文件名合起来，能看出你最近在整理什么；文件内容看不到。"
          }
        }
      }
    },
    "privacy.copy-progress.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; not sent, not logged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里；不发送，不写运行记录"
          }
        }
      }
    },
    "privacy.copy-progress.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress of file copies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件拷贝的进度"
          }
        }
      }
    },
    "privacy.copy-progress.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows copy progress in the notch; never reads file contents or counts folders"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海上显示拷到哪了和拷没拷完；不读文件内容，不去数文件夹"
          }
        }
      }
    },
    "privacy.copy-progress.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The progress Finder publishes while copying: how much is done, of how much, which item, and the filename; only in Downloads, Desktop and Documents"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 拷贝文件时系统公开的进度：做了多少、一共多少、第几个，以及正在拷的文件名；只看下载、桌面、文稿三个文件夹里的"
          }
        }
      }
    },
    "privacy.copy-progress.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how far the copy has got"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示拷到哪了"
          }
        }
      }
    },
    "privacy.copy-progress.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings > Experiments > Copy progress, off by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 > 实验 > 拷贝进度，默认关"
          }
        }
      }
    },
    "privacy.cross-device.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you pick a device and a trusted connection is made"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选定设备并建立可信连接之后"
