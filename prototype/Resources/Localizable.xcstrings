    "settings.remote.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Remote mode off, the remote does nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
