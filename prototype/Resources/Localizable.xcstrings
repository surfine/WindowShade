    "settings.input.smooth.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once on, one notch of the wheel becomes a continuous scroll. The app can't yet tell which mouse an event came from, so it leaves scrolling alone for now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开之后，滚轮的一格会变成一段连续滚动。现在还不能确认事件来自哪只鼠标，所以先不改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟之後，滾輪的一格會變成一段連續捲動。現在還不能確認事件來自哪隻滑鼠，所以先不改。"
          }
        }
      }
    },
    "settings.input.smooth.light": {
      "extractionState": "manual",
      "localizations": {
