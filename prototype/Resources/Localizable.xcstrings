    "settings.shade.trackpad.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-finger swipe, scroll or flick"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在标题栏上两指滑动、滚动滚轮或拖着甩一下：往上收起，往下铺满"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在標題列上兩指滑動、捲動滾輪或拖著甩一下：往上收起，往下鋪滿"
          }
        }
      }
    },
    "settings.shade.trackpad.subSwish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestures are left to Swish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Swish 正在运行，标题栏上的手势交给它；在卷帘条上往下滑仍可展开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Swish 正在執行，標題列上的手勢交給它；在捲簾條上往下滑仍可展開"
          }
        }
      }
    },
