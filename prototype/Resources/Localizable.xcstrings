    "privacy.face-quality.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hints at a clearer shot; a held-up photo or phone counts as no match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示怎么拍得更清楚；看出有人举着照片或手机，就算没认出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示怎麼拍得更清楚；看出有人舉著照片或手機，就算沒認出"
          }
        }
      }
    },
    "privacy.face-quality.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experiment: how clear and bright the face picture is, whether it glares, and whether a screen or phone edge appears in it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验：脸部画面清不清楚、亮不亮、有没有反光，画面里有没有屏幕或手机的边框"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗：臉部畫面清不清楚、亮不亮、有沒有反光，畫面裡有沒有螢幕或手機的邊框"
          }
        }
      }
    },
    "privacy.face-quality.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether a real person is in front of the camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看清镜头前是不是真人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看清鏡頭前是不是真人"
          }
        }
      }
    },
    "privacy.face-quality.toggle": {
