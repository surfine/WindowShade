      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor connections show which project and which session you're conducting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥连接合起来，能看出你在指挥哪个项目、哪段会话。"
