    "settings.shade.timerChime.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One system alert, no repeat; silent when the system is muted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响一次系统提示音，不循环；系统静音时不响"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "響一次系統提示音，不迴圈；系統靜音時不響"
          }
        }
      }
    },
    "settings.shade.trackpad.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title bar gestures"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题栏手势"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
