            "value": "遙控器上的一筆"
          }
        }
      }
    },
    "privacy.remote-touch.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
