    "settings.input.fourFinger.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A four-finger tap hasn't been verified yet, so it can't be turned on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "四指轻点还没核对，先不能开。"
          }
