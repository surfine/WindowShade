      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys and speech from another device show which devices you have and when you use them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
