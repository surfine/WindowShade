      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle-click to roll up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中键收起窗口"
          }
        }
      }
    },
    "settings.input.middleFold.notInstalled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not installed yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
