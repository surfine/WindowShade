    "privacy.headphone-motion.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only with the developer switch on and the silent-actions page open; stops when the page closes, headphones disconnect or the screen locks; callbacks come only on new poses, with no timer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在开发者开关打开、静音操作页开着时读；页面关掉、耳机断开、锁屏就停；系统有新姿态才回调，没有定时器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在開發者開關開啟、靜音操作頁開著時讀；頁面關掉、耳機中斷連線、鎖定畫面就停；系統有新姿態才回調，沒有定時器"
          }
        }
      }
    },
    "privacy.headphone-motion.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head movement from headphones, with the display you're looking at, shows which screen has your attention and whether you nod or shake your head."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耳机的头部朝向和你正在看的屏幕合起来，能看出你在看哪块屏、有没有点头或摇头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "耳機的頭部朝向和你正在看的螢幕合起來，能看出你在看哪塊螢幕、有沒有點頭或搖頭。"
          }
        }
      }
    },
    "privacy.headphone-motion.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; nothing saved or uploaded; a run-only number tells one set of headphones from another"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存；不保存、不上传；不记耳机名字或标识，只用一个本次运行有效的序号区分是不是换了一副"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體；不儲存、不上傳；不記耳機名字或標識，只用一個本次執行有效的序號區分是不是換了一副"
          }
        }
      }
    },
    "privacy.headphone-motion.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head movement from headphones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耳机头动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "耳機頭動"
          }
        }
      }
    },
    "privacy.headphone-motion.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nod to confirm, shake to cancel in silent actions; no speaking, no camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音操作里用点头确认、摇头取消；不用说话，也不用相机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靜音操作裡用點頭確認、搖頭取消；不用說話，也不用相機"
          }
        }
      }
    },
    "privacy.headphone-motion.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head orientation from AirPods (pitch and turn), turned into degrees in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods 的头部朝向（俯仰、左右转），只在内存里换算成度数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods 的頭部朝向（俯仰、左右轉），只在記憶體裡換算成度數"
          }
        }
      }
    },
    "privacy.headphone-motion.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nod to confirm, shake to cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点头确认，摇头取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點頭確認，搖頭取消"
          }
        }
      }
    },
    "privacy.headphone-motion.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A developer switch (not in Settings yet); needs the system's Motion & Fitness permission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者开关（目前不在设置里），需要系统的“动作与健身”权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發者開關（目前不在設定裡），需要系統的“動作與健身”權限"
          }
        }
      }
    },
    "privacy.hid-remapping.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves and applies when you turn it on, and restores the difference when you undo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你开启时保存并应用，撤销时还原差异"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你開啟時儲存並套用，取消時還原差異"
          }
        }
      }
    },
    "privacy.hid-remapping.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key mappings show what you changed on the remote, never what you pressed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键映射合起来，能看出你给遥控器改过哪些键，看不出你按过什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵對映合起來，能看出你給遙控器改過哪些鍵，看不出你按過什麼。"
          }
        }
      }
    },
    "privacy.hid-remapping.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written to the system's key mapping; ownership records hold no input history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写在系统的按键映射里；归属记录不含输入历史"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫在系統的按鍵對映裡；歸屬記錄不含輸入歷史"
          }
        }
      }
    },
    "privacy.hid-remapping.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote button mapping"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器按键映射"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控器按鍵對映"
          }
        }
      }
    },
    "privacy.hid-remapping.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the system's action from firing twice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免系统的动作和 WindowShade 重复响应"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免系統的動作和 WindowShade 重複響應"
          }
        }
      }
    },
    "privacy.hid-remapping.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system's current key mappings, and the few WindowShade adds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统现在的按键映射，和只由 WindowShade 加的几条"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統現在的按鍵對映，和只由 WindowShade 加的幾條"
          }
        }
      }
    },
    "privacy.hid-remapping.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoids reacting twice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免重复响应"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免重複響應"
          }
        }
      }
    },
    "privacy.hid-remapping.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode; mappings other tools added stay as they are"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式；不覆盖别的工具加的映射"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控模式；不覆蓋別的工具加的對映"
          }
        }
      }
    },
    "privacy.hinge.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Desktop lid is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面开合开着时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面開合開著時"
          }
        }
      }
    },
    "privacy.hinge.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lid angle with the lock state shows when you opened or closed this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕开合的角度加上锁屏状态，能看出你什么时候合上或打开了这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕開合的角度加上鎖定畫面狀態，能看出你什麼時候合上或打開了這台 Mac。"
          }
        }
      }
    },
    "privacy.hinge.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用"
          }
        }
      }
    },
    "privacy.hinge.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The angle of the display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕开合的角度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕開合的角度"
          }
        }
      }
    },
    "privacy.hinge.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop folds into the notch as the lid closes, following your hand; with no reading, no effect is drawn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上时桌面折进刘海，跟着手走；读不到就不画这个效果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合上時桌面折進瀏海，跟著手走；讀不到就不畫這個效果"
          }
        }
      }
    },
    "privacy.hinge.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far the lid is open right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕现在开到多少度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕現在開到多少度"
          }
        }
      }
    },
    "privacy.hinge.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lid effect follows the display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖效果跟着屏幕走"
          }
        },
        "zh-Hant": {
          "stringUnit": {
