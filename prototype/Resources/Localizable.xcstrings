    "privacy.login-item.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
