    "settings.shortcuts.tuckAll.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tucks this screen's windows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这块屏上的窗口全部收进刘海，再按一下放回来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這塊螢幕上的視窗全部收進瀏海，再按一下放回來"
          }
        }
      }
    },
    "settings.shortcuts.tuckCurrent.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tucks only the window in front"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只把当前窗口收进刘海"
          }
