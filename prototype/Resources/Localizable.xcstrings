    "settings.shade.levelKeys.allowA11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Accessibility so %@ works"
          }
        },
        "zh-Hans": {
