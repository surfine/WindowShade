    },
    "settings.remote.conductor.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the remote to step into sessions in the notch row: read a session, switch models, leave a draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用遥控器走进刘海那一排里的会话：看会话、换模型、留草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用遙控器走進瀏海那一排裡的工作階段：看工作階段、換模型、留草稿。"
          }
        }
      }
    },
