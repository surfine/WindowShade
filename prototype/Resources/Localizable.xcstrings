    "settings.stripNotch.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a window to the notch in the strip overview and let go to tuck it away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在卷轴概览里把窗口拖到刘海，松手就收进去"
