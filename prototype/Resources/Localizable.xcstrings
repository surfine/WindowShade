          "stringUnit": {
            "state": "translated",
            "value": "List or thumbnails, by count"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动：窗口多的时候用列表，少的时候用缩略图。面板里的切换只影响这一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動：視窗多的時候用列表，少的時候用縮圖。面板裡的切換隻影響這一次。"
          }
        }
      }
    },
    "settings.browser.dockClick.name": {
      "extractionState": "manual",
