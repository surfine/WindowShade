    "settings.browser.arrangeMenu.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange in a window's context menu: left half, right half, corners, center, fill, move to another screen. You can preview it and undo afterwards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在窗口右键菜单里选“排布”：左半、右半、四角、居中、铺满屏幕、移到另一块屏幕。可以先看效果，移好之后还能撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在視窗右鍵選單裡選“排布”：左半、右半、四角、置中、鋪滿螢幕、移到另一塊螢幕。可以先看效果，移好之後還能還原。"
          }
        }
      }
    },
    "settings.browser.axPerm.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds Dock icons and moves windows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别 Dock 图标，切换、收起、展开和关闭窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "識別 Dock 圖示，切換、收起、展開和關閉視窗"
          }
        }
      }
    },
