    "privacy.unlock-secret.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not read at present; it will be enabled separately once there's somewhere to keep it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前不读；有可用的存放方式之后，另行启用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前不讀；有可用的存放方式之後，另行啟用"
          }
        }
      }
    },
    "privacy.unlock-secret.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock credentials in someone else's hands, with the lock state, would open this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁凭据若落到别人手里，合上锁屏状态就能进入这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖憑據若落到別人手裡，合上鎖定畫面狀態就能進入這台 Mac。"
          }
        }
      }
    },
    "privacy.unlock-secret.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept where the system protects it, such as the keychain; never in logs or the assistant's context"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只放在钥匙串这类系统保护的地方；不进运行记录、不进助手的上下文"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只放在鑰匙串這類系統保護的地方；不進執行記錄、不進助手的上下文"
          }
        }
      }
    },
    "privacy.unlock-secret.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock credentials"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁凭据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖憑據"
          }
        }
      }
    },
    "privacy.unlock-secret.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for returning to the desktop after unlocking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用在锁屏之后回到桌面这一步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用在鎖定畫面之後回到桌面這一步"
          }
        }
      }
    },
    "privacy.unlock-secret.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads only the credentials you explicitly created and the system protects"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读你明确建立的、受系统保护的凭据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀你明確建立的、受系統保護的憑據"
          }
        }
      }
    },
    "privacy.unlock-secret.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns to the desktop after unlocking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏后回到桌面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定畫面後回到桌面"
          }
        }
      }
    },
    "privacy.unlock-secret.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the record; without somewhere to keep it, support isn't offered"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除登记；没有可用的存放方式就不显示支持"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除登記；沒有可用的存放方式就不顯示支援"
          }
        }
      }
    },
    "privacy.update.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the chosen frequency while Check for updates automatically is on, or when you click Check for Updates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动检查更新”开着时按频率检查，或你点“检查更新”时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“自動檢查更新”開著時按頻率檢查，或你點“檢查更新”時"
          }
        }
      }
    },
    "privacy.update.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update server sees which version you run and which network you come from, which together show how long it's been since you updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新服务看得到你用哪个版本、从哪个网络来，合起来能看出你多久没更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新服務看得到你用哪個版本、從哪個網路來，合起來能看出你多久沒更新。"
          }
        }
      }
    },
    "privacy.update.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update server (the website; GitHub if it's unreachable)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新服务器（官网；那里不通时改问 GitHub）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新伺服器（官網；那裡不通時改問 GitHub）"
          }
        }
      }
    },
    "privacy.update.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update checks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查更新"
          }
        }
      }
    },
    "privacy.update.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches the new-version list and the download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取得新版本的清单和下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取得新版本的清單和下載"
          }
        }
      }
    },
    "privacy.update.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WindowShade's version, plus the network information the update server sees anyway"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WindowShade 的版本号，以及更新服务器本来就看得到的网络信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WindowShade 的版本號，以及更新伺服器本來就看得到的網路資訊"
          }
        }
      }
    },
    "privacy.update.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks the website whether there's a new version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问官网有没有新版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問官網有沒有新版本"
          }
        }
      }
    },
    "privacy.update.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates automatically; manual checks still work when it's off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新；关掉后仍可手动检查"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動檢查更新；關掉後仍可手動檢查"
          }
        }
      }
    },
    "privacy.window-ax.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When rolling up, putting back and arranging"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起、放回、排窗口时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收起、放回、排視窗時"
          }
        }
      }
    },
    "privacy.window-ax.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window titles and positions together show which file you're working on and which page you're reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口的标题和位置合起来，能看出你在处理哪份文件、看哪个网页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗的標題和位置合起來，能看出你在處理哪份檔案、看哪個網頁。"
          }
        }
      }
    },
    "privacy.window-ax.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; rolled-up window titles and positions go into recovery records"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用；收起的窗口的标题和位置记在恢复记录里，出问题时用来找回窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用；收起的視窗的標題和位置記在回復記錄裡，出問題時用來找回視窗"
          }
        }
      }
    },
    "privacy.window-ax.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window titles, positions and sizes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口的标题、位置和大小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗的標題、位置和大小"
          }
        }
      }
    },
    "privacy.window-ax.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolling up, putting back and arranging all need to know where windows are"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起、放回、排窗口，都要先知道窗口在哪"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收起、放回、排視窗，都要先知道視窗在哪"
          }
        }
      }
    },
    "privacy.window-ax.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window titles, positions and sizes, and which app each belongs to"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口的标题、位置和大小，以及它属于哪个 App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗的標題、位置和大小，以及它屬於哪個 App"
          }
        }
      }
    },
    "privacy.window-ax.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds, moves and restores windows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到、移动和恢复窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找到、移動和回復視窗"
          }
        }
      }
    },
    "privacy.window-ax.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off Accessibility (Device Control and Data Access from macOS 27) and WindowShade can no longer read windows"
          }
        },
        "zh-Hans": {
