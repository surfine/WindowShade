    "privacy.level-hud.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With notch hints on; volume is read on change and brightness within 0.6 seconds of a press; without key events brightness is read every 0.2 seconds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海提示开着时；音量有变化就读，亮度只在按键后 0.6 秒内读；听不到按键时退回每 0.2 秒读一次亮度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海提示開著時；音量有變化就讀，亮度只在按鍵後 0.6 秒內讀；聽不到按鍵時退回每 0.2 秒讀一次亮度"
          }
        }
      }
    },
    "privacy.level-hud.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When volume and brightness were changed, with the hours you use the Mac, shows roughly when you're using it; never what you listen to or watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量和亮度什么时候被调过，合上你的使用时段，能看出你大概什么时候在用这台 Mac；看不出你在听什么、看什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音量和亮度什麼時候被調過，合上你的使用時段，能看出你大概什麼時候在用這台 Mac；看不出你在聽什麼、看什麼。"
          }
        }
      }
    },
    "privacy.level-hud.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory; never sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存；不发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體；不傳送"
          }
        }
      }
    },
    "privacy.level-hud.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume and brightness"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量和亮度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音量和亮度"
          }
        }
      }
    },
    "privacy.level-hud.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows only on a real key press; value changes without one stay off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真的按了音量、亮度键，才在刘海显示；没人按键时数值变了也不显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "真的按了音量、亮度鍵，才在瀏海顯示；沒人按鍵時數值變了也不顯示"
          }
        }
      }
    },
    "privacy.level-hud.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current output volume and mute, the brightness of the display under the pointer, and whether the volume or brightness keys were pressed (only these media keys)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前输出音量和静音、指针所在屏幕的亮度，以及音量、亮度键有没有被按下（只看这几个媒体键）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前輸出音量和靜音、指標所在螢幕的亮度，以及音量、亮度鍵有沒有被按下（只看這幾個媒體鍵）"
          }
        }
      }
    },
    "privacy.level-hud.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when you press volume or brightness keys"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按音量、亮度键时显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按音量、亮度鍵時顯示"
          }
        }
      }
    },
    "privacy.level-hud.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the notch features; turning off Volume and brightness in Settings stops it too"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟着刘海功能走；设置里的“音量和亮度”关掉后也不再显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟著瀏海功能走；設定裡的“音量和亮度”關掉後也不再顯示"
          }
        }
      }
    },
    "privacy.level-keys.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only with Accessibility granted and this macOS version verified; read and written on those key presses, never polled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在允许了辅助功能、且这个 macOS 版本核对过时；按了这几个键才读才写，平时不轮询"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在允許了輔助使用、且這個 macOS 版本核對過時；按了這幾個鍵才讀才寫，平時不輪詢"
          }
        }
      }
    },
    "privacy.level-keys.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When these keys were pressed and how far you turned volume and brightness up, with the hours you use the Mac, show when you're using it and whether you're watching or listening; never what you watch or hear, and never what you type."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这几个键什么时候被按过、音量和亮度调成多少，合上你的使用时段，能看出你什么时候在用这台 Mac、是不是在看片或听东西；看不出你在听什么、看什么，也收不到你打的字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這幾個鍵什麼時候被按過、音量和亮度調成多少，合上你的使用時段，能看出你什麼時候在用這台 Mac、是不是在看片或聽東西；看不出你在聽什麼、看什麼，也收不到你打的字。"
          }
        }
      }
    },
    "privacy.level-keys.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; not sent, not logged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里；不发送，不写运行记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡；不傳送，不寫執行記錄"
          }
        }
      }
    },
    "privacy.level-keys.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume and brightness keys"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量和亮度键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音量和亮度鍵"
          }
        }
      }
    },
    "privacy.level-keys.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catches these keys and shows them at the notch instead; the change is written back at the system's own step and read back to check, and handed back if it doesn't match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拦下这几个键，由刘海显示，系统自己的提示藏起来；拦下的那一下照系统的步长写回系统输出音量与静音、内建屏亮度、键盘灯亮度，写完读回核对，不对就把这一下原样交还系统"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "攔下這幾個鍵，由瀏海顯示，系統自己的提示藏起來；攔下的那一下照系統的步長寫回系統輸出音量與靜音、內建螢幕亮度、鍵盤燈亮度，寫完讀回核對，不對就把這一下原樣交還系統"
          }
        }
      }
    },
    "privacy.level-keys.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presses and releases of the system keys volume +/−, mute, brightness +/− and keyboard backlight +/−; only this class of system key is subscribed to, so typing keys never arrive. On a press it reads whether the default output can be adjusted, its transport (built-in, Bluetooth, HDMI and so on) and model name (only to recognize AirPods and headphones and swap the symbol on the left), the current volume and mute, the built-in display's brightness, the keyboard backlight level, and the system's Play feedback when changing volume"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量 +/−、静音、亮度 +/−、键盘灯 +/− 这几个系统按键的按下和松开；只订阅系统按键这一类，打字的键收不到。按下时读默认输出设备能不能调、它的传输方式（内建、蓝牙、HDMI 等）和型号名（只为认出 AirPods 和耳机、换左边的符号）、当前音量和静音、内建屏亮度、键盘灯亮度，以及系统“调音量时播放反馈”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音量 +/−、靜音、亮度 +/−、鍵盤燈 +/− 這幾個系統按鍵的按下和鬆開；只訂閱系統按鍵這一類，打字的鍵收不到。按下時讀預設輸出裝置能不能調、它的傳輸方式（內建、藍牙、HDMI 等）和型號名（只為認出 AirPods 和耳機、換左邊的符號）、當前音量和靜音、內建螢幕亮度、鍵盤燈亮度，以及系統“調音量時播放回饋”"
          }
        }
      }
    },
    "privacy.level-keys.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when you press volume or brightness keys"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按音量、亮度键时显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按音量、亮度鍵時顯示"
          }
        }
      }
    },
    "privacy.level-keys.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume and brightness in Settings (on by default); without Accessibility or a verified version it only listens"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的“音量和亮度”（默认开）；没允许辅助功能或版本没核对过就只旁听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定裡的“音量和亮度”（預設開）；沒允許輔助使用或版本沒核對過就只旁聽"
          }
        }
      }
    },
    "privacy.lock-now-private.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only with Lock when you leave on and your phone recognized"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在打开“离开就锁”，并且认得出你的手机之后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在開啟“離開就鎖”，並且認得出你的手機之後"
          }
        }
      }
    },
    "privacy.lock-now-private.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither alone nor together do these say who you are or what you're doing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独和合起来都看不出你是谁、在做什么"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單獨和合起來都看不出你是誰、在做什麼"
          }
        }
      }
    },
    "privacy.lock-now-private.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never sent, never recorded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不发送，不记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不傳送，不記錄"
          }
        }
      }
    },
    "privacy.lock-now-private.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locking the screen right away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即锁屏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即鎖定畫面"
          }
        }
      }
    },
    "privacy.lock-now-private.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock when you leave: locks this Mac after the countdown once the phone walks away; never unlocks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开就锁：手机走远、倒数完后锁上这台 Mac；从不解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開就鎖：手機走遠、倒數完後鎖上這台 Mac；從不解鎖"
          }
        }
      }
    },
    "privacy.lock-now-private.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads nothing and only asks the system to lock at once; whether it locked is taken from the system's lock state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不读任何东西，只让系统立刻锁屏；锁没锁上，以系统的锁屏状态为准"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不讀任何東西，只讓系統立刻鎖定畫面；鎖沒鎖上，以系統的鎖定畫面狀態為準"
          }
        }
      }
    },
    "privacy.lock-now-private.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks as soon as you walk away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走远后立刻锁屏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "走遠後立刻鎖定畫面"
          }
        }
      }
    },
    "privacy.lock-now-private.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock when you leave (off by default)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开就锁（默认关）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開就鎖（預設關）"
          }
        }
      }
    },
    "privacy.lock-state.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated on locking and unlocking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏、解锁时更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定畫面、解鎖時更新"
          }
        }
      }
    },
    "privacy.lock-state.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock state with Lock when you leave shows roughly when you're at your desk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏状态和离开就锁的设置合起来，能看出你大概什么时候在桌前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定畫面狀態和離開就鎖的設定合起來，能看出你大概什麼時候在桌前。"
          }
        }
      }
    },
    "privacy.lock-state.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用"
          }
        }
      }
    },
    "privacy.lock-state.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the screen is locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否锁屏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是否鎖定畫面"
          }
        }
      }
    },
    "privacy.lock-state.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does nothing while locked; picks up after unlocking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏期间什么都不做，解锁后再接上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定畫面期間什麼都不做，解鎖後再接上"
          }
        }
      }
    },
    "privacy.lock-state.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the screen is locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁了还是没锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖了還是沒鎖"
          }
        }
      }
    },
    "privacy.lock-state.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notch drawing and no window moves while locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏时不画刘海、不动窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定畫面時不畫瀏海、不動視窗"
          }
        }
      }
    },
    "privacy.lock-state.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For safety this can't be turned off on its own"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了安全，不能单独关掉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了安全，不能單獨關掉"
          }
        }
      }
    },
    "privacy.login-item.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read once when Settings opens, submitted when you change it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置时读一次，你改的时候提交"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟設定時讀一次，你改的時候提交"
          }
        }
      }
    },
    "privacy.login-item.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login, with the run logs, shows roughly what time you start using this Mac each day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动合上运行记录，能看出你每天大概几点开始用这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時自動啟動合上執行記錄，能看出你每天大概幾點開始用這台 Mac。"
          }
        }
      }
    },
    "privacy.login-item.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed to the system's login item"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交给系统的登录项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交給系統的登入項"
          }
        }
      }
    },
    "privacy.login-item.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時自動啟動"
          }
        }
      }
    },
    "privacy.login-item.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens after you log in, as you chose"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的选择，登录后自动打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的選擇，登入後自動開啟"
          }
        }
      }
    },
    "privacy.login-item.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether WindowShade is set to open at login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WindowShade 有没有设成登录时启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WindowShade 有沒有設成登入時啟動"
          }
        }
      }
    },
    "privacy.login-item.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens automatically after you log in"
          }
        },
        "zh-Hans": {
