            "value": "遙控器按鈕"
          }
        }
      }
    },
    "privacy.remote-hid.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps to actions in Remote mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
