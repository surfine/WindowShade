    "privacy.remote-volume.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Remote mode on, an iPhone connected and a volume key pressed; nothing is read or written without a press"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式开着、iPhone 已连上、按了音量键时；不按键就不读不写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控模式開著、iPhone 已連上、按了音量鍵時；不按鍵就不讀不寫"
          }
        }
      }
    },
    "privacy.remote-volume.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often you changed volume from the remote, with the times it was connected, shows when you use it; never what you listen to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器调过几次音量，合上连接的时段，能看出你什么时候在用遥控器；看不出你在听什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控器調過幾次音量，合上連線的時段，能看出你什麼時候在用遙控器；看不出你在聽什麼。"
          }
        }
      }
    },
    "privacy.remote-volume.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; never sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里；不发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡；不傳送"
          }
        }
      }
    },
    "privacy.remote-volume.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume changes from the remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用遥控器调音量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用遙控器調音量"
          }
        }
      }
    },
    "privacy.remote-volume.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes this Mac's volume from the iPhone remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 iPhone 上的遥控器调这台 Mac 的音量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 iPhone 上的遙控器調這台 Mac 的音量"
          }
        }
      }
    },
    "privacy.remote-volume.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current output volume; a volume key adds or removes one step and writes it back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前输出音量；按音量键时在原来的基础上加减一格并写回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前輸出音量；按音量鍵時在原來的基礎上加減一格並寫回"
          }
        }
      }
    },
    "privacy.remote-volume.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote's volume buttons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器的音量键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控器的音量鍵"
          }
        }
      }
    },
    "privacy.remote-volume.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode; turning it off stops the changes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式；关掉就不再调"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控模式；關掉就不再調"
          }
        }
      }
    },
    "privacy.screen-shape.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read when needed, and once when the Privacy page opens"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用到的时候读；打开隐私这一页时读一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用到的時候讀；開啟隱私權這一頁時讀一次"
          }
        }
      }
    },
    "privacy.screen-shape.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number of displays and the notch shape together show which kind of Mac you use and whether a monitor is attached."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕数量和刘海形状合起来，能看出你用的是哪一类 Mac，有没有接外接显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕數量和瀏海形狀合起來，能看出你用的是哪一類 Mac，有沒有接外接顯示器。"
          }
        }
      }
    },
    "privacy.screen-shape.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用"
          }
        }
      }
    },
    "privacy.screen-shape.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shape of the display and the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕和刘海的形状"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕和瀏海的形狀"
          }
        }
      }
    },
    "privacy.screen-shape.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts controls on the right display, next to the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把控件放在对的那块屏、刘海旁边"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把控制元件放在對的那塊螢幕、瀏海旁邊"
          }
        }
      }
    },
    "privacy.screen-shape.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many displays there are, their sizes, and whether there's a notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕有几块、多大，有没有刘海"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕有幾塊、多大，有沒有瀏海"
          }
        }
      }
    },
    "privacy.screen-shape.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugs the body when tucked into the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收进刘海时贴着机身"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收進瀏海時貼著機身"
          }
        }
      }
    },
    "privacy.screen-shape.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switch of its own; it follows the notch features"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有单独的开关，跟着刘海功能走"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有單獨的開關，跟著瀏海功能走"
          }
        }
      }
    },
    "privacy.settings.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read when the feature needs it; the Privacy page only shows values already read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功能需要时读；隐私这一页只读已有的值"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "功能需要時讀；隱私權這一頁唯讀已有的值"
          }
        }
      }
    },
    "privacy.settings.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings together show how you work and which features you've turned on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设置合起来，能看出你的使用习惯和开过哪些功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的設定合起來，能看出你的使用習慣和開過哪些功能。"
          }
        }
      }
    },
    "privacy.settings.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this Mac; one-time approval tickets aren't kept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在这台 Mac 上；不存一次性的批准票据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存在這台 Mac 上；不存一次性的批准票據"
          }
        }
      }
    },
    "privacy.settings.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "privacy.settings.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembers your choice and follows the system setting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住你的选择，也跟着系统设置走"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記住你的選擇，也跟著系統設定走"
          }
        }
      }
    },
    "privacy.settings.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The choices you make in Settings (including the countdown minutes you last picked and each app's last column widths in the scroll strip) and a few system settings (including whether the system is muted)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在设置里做的选择（含上次选的计时分钟数、卷轴里每个 App 上次用的列宽），和用到的几项系统设置（含系统是否静音）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在設定裡做的選擇（含上次選的計時分鐘數、卷軸裡每個 App 上次用的列寬），和用到的幾項系統設定（含系統是否靜音）"
          }
        }
      }
    },
    "privacy.settings.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembers your choice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住你的选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記住你的選擇"
          }
        }
      }
    },
    "privacy.settings.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switches in Settings; Reset clears only WindowShade's own values"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的各项开关；“重置”只清 WindowShade 自己的值"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定裡的各項開關；“重置”只清 WindowShade 自己的值"
          }
        }
      }
    },
    "privacy.spaces-private.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you look at other desktops in the notch row or the window browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在刘海那一排或窗口浏览里看别的桌面时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在瀏海那一排或視窗瀏覽裡看別的桌面時"
          }
        }
      }
    },
    "privacy.spaces-private.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows on other desktops and their pictures together show what else you have open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他桌面的窗口和画面合起来，能看出你在别的桌面上还开着什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他桌面的視窗和畫面合起來，能看出你在別的桌面上還開著什麼。"
          }
        }
      }
    },
    "privacy.spaces-private.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for previews, never sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来显示预览，不发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來顯示預覽，不傳送"
          }
        }
      }
    },
    "privacy.spaces-private.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictures of windows on other desktops and minimized"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他桌面和最小化窗口的画面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他桌面和最小化視窗的畫面"
          }
        }
      }
    },
    "privacy.spaces-private.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public APIs can't capture windows on other desktops or minimized ones; app icons stand in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开接口拿不到别的桌面和已最小化窗口的画面；读不到时显示应用图标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開介面拿不到別的桌面和已最小化視窗的畫面；讀不到時顯示應用圖示"
          }
        }
      }
    },
    "privacy.spaces-private.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which windows are on other desktops, where they sit and their pictures; it also reads whether this display is a full-screen desktop (the notch steps aside while full screen or Mission Control is open)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别的桌面上有哪些窗口、窗口在哪，以及它们的画面；也读你这块屏现在是不是全屏桌面（全屏或调度中心开着时刘海让开）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "別的桌面上有哪些視窗、視窗在哪，以及它們的畫面；也讀你這塊螢幕現在是不是全螢幕桌面（全螢幕或指揮中心開著時瀏海讓開）"
          }
        }
      }
    },
    "privacy.spaces-private.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every window shows up in the notch row"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海那一排能看到每一扇"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海那一排能看到每一扇"
          }
        }
      }
    },
    "privacy.spaces-private.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off Screen Recording in System Settings and only icons show"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置里关掉“屏幕录制”，就只显示图标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定裡關掉“螢幕錄製”，就只顯示圖示"
          }
        }
      }
    },
    "privacy.speech-input.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you hold and speak, up to 60 seconds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你按住说话时，最长 60 秒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你按住說話時，最長 60 秒"
          }
        }
      }
    },
    "privacy.speech-input.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech and its transcription together show what you say and when."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音和转写的文字合起来，能看出你在说什么、什么时候在说。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音和轉寫的文字合起來，能看出你在說什麼、什麼時候在說。"
          }
        }
      }
    },
    "privacy.speech-input.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognized on this Mac by default; if it can't, that's switched off and you're told; the cloud needs separate consent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认在这台 Mac 上识别；这台 Mac 不能识别就停用并告诉你，用云端要另外征得你同意"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設在這台 Mac 上識別；這台 Mac 不能識別就停用並告訴你，用雲端要另外徵得你同意"
          }
        }
      }
    },
    "privacy.speech-input.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音輸入"
          }
        }
      }
    },
    "privacy.speech-input.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes a draft; press play again to submit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成草稿，你再按一次播放才提交"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成草稿，你再按一次播放才提交"
          }
        }
      }
    },
    "privacy.speech-input.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound from the microphone you picked, and a temporary transcription"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选的麦克风的声音、临时转写的文字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選的麥克風的聲音、臨時轉寫的文字"
          }
        }
      }
    },
    "privacy.speech-input.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say a sentence, get a draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说一句，得到草稿"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說一句，得到草稿"
          }
        }
      }
    },
    "privacy.speech-input.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks the microphone; letting go or cancelling stops it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择麦克风；松手或取消就停"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇麥克風；鬆手或取消就停"
          }
        }
      }
    },
    "privacy.system-quiet.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At launch, and once each time you switch apps, an app launches or quits, the screen locks or unlocks, or you change desktops; no timers. Focus is read only after you turn the switch on here and agree in the system prompt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时，以及切换 App、App 启动或退出、锁屏或解锁、换桌面时各读一次，不会定时去读；专注模式要你在这里打开开关、再在系统弹窗里同意后才读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動時，以及切換 App、App 啟動或退出、鎖定畫面或解鎖、換桌面時各讀一次，不會定時去讀；專注模式要你在這裡開啟開關、再在系統彈出視窗裡同意後才讀"
          }
        }
      }
    },
    "privacy.system-quiet.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the screen is shared with whether Focus is on shows you're probably in a meeting or presenting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否在共享屏幕和是否开着专注模式合起来，能看出你大概正在开会或演示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是否在共享螢幕和是否開著專注模式合起來，能看出你大概正在開會或示範。"
          }
        }
      }
    },
    "privacy.system-quiet.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; not recorded, not sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用，不记录，不发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用，不記錄，不傳送"
          }
        }
      }
    },
    "privacy.system-quiet.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the screen is shared and Focus is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕是否在被共享、专注模式是否开着"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕是否在被共享、專注模式是否開著"
          }
        }
      }
    },
    "privacy.system-quiet.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While sharing, private apps show only an icon in the notch row and stuck hints stay silent; in Focus a brief notice leaves just a dot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享屏幕时，私人 App 在刘海那一排里只显示图标，卡住提示不出声；专注模式开着时，短暂提醒只留一个小点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享螢幕時，私人 App 在瀏海那一排裡只顯示圖示，卡住提示不出聲；專注模式開著時，短暫提醒只留一個小點"
          }
        }
      }
    },
    "privacy.system-quiet.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the screen is being shared or recorded and whether Focus is on; only yes or no is read, never who it's shared with or the name of the Focus"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕有没有正在被共享或录制，系统专注模式开没开；只读“有”或“没有”，不读共享给了谁、专注模式的名字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕有沒有正在被共享或錄製，系統專注模式開沒開；唯讀“有”或“沒有”，不讀共享給了誰、專注模式的名字"
          }
        }
      }
    },
    "privacy.system-quiet.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notch keeps quieter while sharing or in Focus"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享或专注时刘海更安静"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享或專注時瀏海更安靜"
          }
        }
      }
    },
    "privacy.system-quiet.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus: expand this row, turn on Quieter in Focus and agree in the system prompt; off by default. Sharing has no switch of its own — it only quiets the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注模式：展开这一行，打开「专注模式时更安静」并在系统弹窗里同意才读，默认关；共享状态没有单独的开关，它只会让刘海更安静"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專注模式：展開這一行，開啟「專注模式時更安靜」並在系統彈出視窗裡同意才讀，預設關；共享狀態沒有單獨的開關，它只會讓瀏海更安靜"
          }
        }
      }
    },
    "privacy.tilt.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read while Desktop lid is on, stopping when it's off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面开合开着时读，关掉就停"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面開合開著時讀，關掉就停"
          }
        }
      }
    },
    "privacy.tilt.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body tilt with the lid angle shows whether this Mac is on a desk, a lap or in your hands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机身倾斜加上屏幕开合，能看出这台 Mac 是在桌上，还是在腿上或手里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機身傾斜加上螢幕開合，能看出這台 Mac 是在桌上，還是在腿上或手裡。"
          }
        }
      }
    },
    "privacy.tilt.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用"
          }
        }
      }
    },
    "privacy.tilt.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the body is tilted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机身的倾斜"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機身的傾斜"
          }
        }
      }
    },
    "privacy.tilt.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves the lid effect's light with the body's angle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让开合时的光影跟着机身角度变"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓開合時的光影跟著機身角度變"
          }
        }
      }
    },
    "privacy.tilt.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which way the body tilts and whether it's moving"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
