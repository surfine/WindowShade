    },
    "privacy.input-gamepad.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A controller's buttons, sticks and gyroscope together show how you hold and move it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
