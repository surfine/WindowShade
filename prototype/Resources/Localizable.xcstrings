          }
        }
      }
    },
    "privacy.music-levels.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listens while the notch shows the song, or the card is open, and something is playing; stops after 3 seconds paused, when tucked, locked or full screen; not while the output is Bluetooth headphones or the source is Spotify"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海露着正在放的歌、或大卡开着，而且在放时才听；暂停 3 秒、收回、锁屏、全屏就停；输出是蓝牙耳机、来源是 Spotify 时不听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海露著正在放的歌、或大卡開著，而且在放時才聽；暫停 3 秒、收回、鎖定畫面、全螢幕就停；輸出是藍牙耳機、來源是 Spotify 時不聽"
          }
        }
      }
    },
    "privacy.music-levels.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loudness with the song playing shows when you're listening."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音大小合上正在放的歌，能看出你什么时候在听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聲音大小合上正在放的歌，能看出你什麼時候在聽。"
          }
        }
      }
    },
    "privacy.music-levels.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; drawn 30 times a second from 5 numbers; nothing stored, sent or logged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里，每秒换成 30 次 5 个数画出来；不存，不发送，不写进运行记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡，每秒換成 30 次 5 個數畫出來；不存，不傳送，不寫進執行記錄"
          }
        }
      }
    },
    "privacy.music-levels.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How loud playback is"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放的声音大小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放的聲音大小"
          }
        }
      }
    },
    "privacy.music-levels.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises and falls with the song on the notch's right"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让刘海右边的小点随正在放的歌起伏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓瀏海右邊的小點隨正在放的歌起伏"
          }
        }
      }
    },
    "privacy.music-levels.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How loud the app that's playing is, in five steps from quiet to loud; only that app is listened to and the sound itself isn't kept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在放歌的那个 App 的声音有多大，分成高低 5 段；只听它一个，声音本身不留下"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在放歌的那個 App 的聲音有多大，分成高低 5 段；只聽它一個，聲音本身不留下"
          }
        }
      }
    },
    "privacy.music-levels.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dot on the notch's right rises and falls with the song"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海右边的小点随歌起伏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海右邊的小點隨歌起伏"
          }
        }
      }
    },
    "privacy.music-levels.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounce with the sound in Settings, off by default; turning it on is when the system asks about System Audio Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的“跟着声音跳”，默认关；打开时系统才问你“系统音频录制”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定裡的“跟著聲音跳”，預設關；開啟時系統才問你“系統音訊錄製”"
          }
        }
      }
    },
    "privacy.music.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read whenever a playback-change notice arrives, with a timer as a backstop if one is missed; Lock when you leave checks once before locking and once after unlocking; only a broken push stream falls back to asking Music and Spotify, which is when Automation may be requested"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放变化的通知一来就读；通知漏掉时有一个定时兜底；离开就锁锁屏前、解开后各看一次在不在放；只有推送流坏了才退回问音乐和 Spotify，那时才可能请你允许“自动化”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放變化的通知一來就讀；通知漏掉時有一個定時兜底；離開就鎖鎖定畫面前、解開後各看一次在不在放；只有推播流壞了才退回問音樂和 Spotify，那時才可能請你允許“自動化”"
          }
        }
      }
    },
    "privacy.music.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The song playing, with the hours you use the Mac, shows your taste in music and your daily rhythm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的歌合上你的使用时段，能看出你的音乐口味和作息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的歌合上你的使用時段，能看出你的音樂口味和作息。"
          }
        }
      }
    },
    "privacy.music.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; song titles stay out of the logs, one cover is kept in memory"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用，歌名不写进运行记录；封面只在内存里留最新一张，不落盘"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用，歌名不寫進執行記錄；封面只在記憶體裡留最新一張，不落盤"
          }
        }
      }
    },
    "privacy.music.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The song playing now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的歌"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的歌"
          }
        }
      }
    },
    "privacy.music.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Song and progress in the notch and Launchpad, with pause and skip"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海和启动台里显示歌名、进度，能暂停和切歌"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海和啟動台裡顯示歌名、進度，能暫停和切歌"
          }
        }
      }
    },
    "privacy.music.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title, artist and progress of the song playing, and whether it's playing or paused; one cover is fetched when the song changes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播的歌名、歌手、进度，以及是在播放还是暂停；换歌时取一次封面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播的歌名、歌手、進度，以及是在播放還是暫停；換歌時取一次封面"
          }
        }
      }
    },
    "privacy.music.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music and Spotify"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐和 Spotify"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂和 Spotify"
          }
        }
      }
    },
    "privacy.music.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now Playing (on by default) and Live activities in Settings; falling back to Music and Spotify also needs Automation in System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的“正在播放”（默认开）和“实时活动”；退回问音乐和 Spotify 时，还要系统设置里的“自动化”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定裡的“正在播放”（預設開）和“即時活動”；退回問音樂和 Spotify 時，還要系統設定裡的“自動化”"
          }
        }
      }
    },
    "privacy.notch-private.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read once on a display change and noted down"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕变化时读一次，记下来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕變化時讀一次，記下來"
          }
        }
      }
    },
    "privacy.notch-private.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither alone nor together do these say who you are or what you're doing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独和合起来都看不出你是谁、在做什么"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單獨和合起來都看不出你是誰、在做什麼"
          }
        }
      }
    },
    "privacy.notch-private.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用"
          }
        }
      }
    },
    "privacy.notch-private.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact outline of the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海的精确轮廓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海的精確輪廓"
          }
        }
      }
    },
    "privacy.notch-private.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugs the body's edges"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让界面贴合机身的边缘"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓介面貼合機身的邊緣"
          }
        }
      }
    },
    "privacy.notch-private.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notch's outline and corner radius"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海的轮廓和圆角"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海的輪廓和圓角"
          }
        }
      }
    },
    "privacy.notch-private.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps things in the notch inside the rounded corners"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让刘海里的东西贴着圆角"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓瀏海里的東西貼著圓角"
          }
        }
      }
    },
    "privacy.notch-private.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switch of its own; a plain rectangle stands in when it can't be read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有单独的开关；读不到时退回矩形，看起来略生硬"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有單獨的開關；讀不到時退回矩形，看起來略生硬"
          }
        }
      }
    },
    "privacy.now-playing-stream.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates are pushed on change, never polled; no first line within 10 seconds, or three exits within 60, counts as broken and falls back to Music and Spotify; Lock when you leave asks once before locking and once after unlocking; commands go out only when you scrub or press previous, next, play or pause"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统有变化时推过来，不定时去问；10 秒内没有第一行、或 60 秒内退出 3 次就当它坏了，退回问音乐和 Spotify；离开就锁锁屏前、解开后各问一次在不在放；只有你拖进度条、点上一首下一首播放暂停时才发命令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統有變化時推過來，不定時去問；10 秒內沒有第一行、或 60 秒內退出 3 次就當它壞了，退回問音樂和 Spotify；離開就鎖鎖定畫面前、解開後各問一次在不在放；只有你拖進度條、點上一首下一首播放暫停時才發命令"
          }
        }
      }
    },
    "privacy.now-playing-stream.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What any player is playing, with the hours you use the Mac, shows what you listen to and watch, and your daily rhythm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有播放器正在放的内容合上你的使用时段，能看出你在听什么、看什么视频，以及作息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有播放器正在放的內容合上你的使用時段，能看出你在聽什麼、看什麼影片，以及作息。"
          }
        }
      }
    },
    "privacy.now-playing-stream.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads system playback info with a small bundled script; in memory; titles stay out of the logs; never sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 WindowShade 自带的一小段脚本读系统的播放信息；只在内存里；歌名不写进运行记录；不发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過 WindowShade 自帶的一小段指令碼讀系統的播放資訊；只在記憶體裡；歌名不寫進執行記錄；不傳送"
          }
        }
      }
    },
    "privacy.now-playing-stream.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The song any player is playing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何播放器正在放的歌"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何播放器正在放的歌"
          }
        }
      }
    },
    "privacy.now-playing-stream.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not only Music and Spotify — browsers and other players show and control too"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不只 Music 和 Spotify，网页和别的播放器也能显示和控制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不只 Music 和 Spotify，網頁和別的播放器也能顯示和控制"
          }
        }
      }
    },
    "privacy.now-playing-stream.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app playing, track, artist, progress and play state; one cover is fetched when the song changes; when you let go of the scrubber on the card, one seek is sent to the app that's playing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的 App、曲目、艺人、进度、播放状态；换歌时单独取一次封面；你在大卡上松开进度条时，向正在播的 App 发一次跳转"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的 App、曲目、藝人、進度、播放狀態；換歌時單獨取一次封面；你在大卡上鬆開進度條時，向正在播的 App 發一次跳轉"
          }
        }
      }
    },
    "privacy.now-playing-stream.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works for browsers and other players too"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页和别的播放器也能显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網頁和別的播放器也能顯示"
          }
        }
      }
    },
    "privacy.now-playing-stream.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default until you change it; turning off Now Playing or Live activities in Settings stops it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认开（没设置过就是开）；设置里的“正在播放”或实时活动关掉就停"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設開（沒設定過就是開）；設定裡的“正在播放”或即時活動關掉就停"
          }
        }
      }
    },
    "privacy.pair-verify-identity.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the keychain only while Remote mode is on; a new pairing needs Touch ID at the notch first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式打开时才从钥匙串读；新配对要先在刘海里用 Touch ID 确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控模式開啟時才從鑰匙串讀；新配對要先在瀏海里用 Touch ID 確認"
          }
        }
      }
    },
    "privacy.pair-verify-identity.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other side's public keys together reveal which devices you've paired."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对端的公钥合起来，能认出你配对过哪台设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對端的公鑰合起來，能認出你配對過哪台裝置。"
          }
        }
      }
    },
    "privacy.pair-verify-identity.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public keys and device names go into this Mac's keychain; session keys stay in memory"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公钥和设备名存在这台 Mac 的钥匙串里；会话密钥只在内存中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公鑰和裝置名存在這台 Mac 的鑰匙串裡；工作階段金鑰只在記憶體中"
          }
        }
      }
    },
    "privacy.pair-verify-identity.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity of the paired device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对后的对端身份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對後的對端身份"
          }
        }
      }
    },
    "privacy.pair-verify-identity.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this device can step into Conductor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有这台设备能进入指挥模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有這台裝置能進入指揮模式"
          }
        }
      }
    },
    "privacy.pair-verify-identity.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The paired iPhone's public key, version and self-reported device name, and this connection's session key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对 iPhone 的公钥、版本号和它报的设备名，以及这次连接的会话密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已配對 iPhone 的公鑰、版本號和它報的裝置名，以及這次連線的工作階段金鑰"
          }
        }
      }
    },
    "privacy.pair-verify-identity.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only paired devices get in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只让配对过的设备进入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只讓配對過的裝置進入"
          }
        }
      }
    },
    "privacy.pair-verify-identity.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode; Remove in Settings undoes this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式；设置里的「移除」撤销这一台"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控模式；設定裡的「移除」取消這一台"
          }
        }
      }
    },
    "privacy.pointing-device.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read once when a Settings page with a demo opens"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开有演示的设置页时读一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開有示範的設定頁時讀一次"
          }
        }
      }
    },
    "privacy.pointing-device.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All that's known is whether there's a trackpad, never what you do on it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只知道有没有触控板，看不出你在上面做了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只知道有沒有觸控式軌跡板，看不出你在上面做了什麼。"
          }
        }
      }
    },
    "privacy.pointing-device.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用"
          }
        }
      }
    },
    "privacy.pointing-device.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether there's a trackpad"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有没有触控板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有沒有觸控式軌跡板"
          }
        }
      }
    },
    "privacy.pointing-device.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the demos in Settings show a trackpad or a mouse"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的演示画触控板还是鼠标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定裡的示範畫觸控式軌跡板還是滑鼠"
          }
        }
      }
    },
    "privacy.pointing-device.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether this Mac has a trackpad (built-in or Magic Trackpad); fingers aren't read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 连没连着触控板（内建的或妙控板）；不读手指"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 連沒連著觸控式軌跡板（內建的或巧控板）；不讀手指"
          }
        }
      }
    },
    "privacy.pointing-device.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demos in Settings show the device in your hand"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的演示画你手上的设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定裡的示範畫你手上的裝置"
          }
        }
      }
    },
    "privacy.pointing-device.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switch of its own; it follows the demos in Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有单独的开关，跟着设置里的演示走"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有單獨的開關，跟著設定裡的示範走"
          }
        }
      }
    },
    "privacy.presence-bluetooth.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Lock when you leave on and a device picked, the connection is read every few seconds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开就锁打开且选了随身设备后，每隔几秒读一次连接状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開就鎖開啟且選了隨身裝置後，每隔幾秒讀一次連線狀態"
          }
        }
      }
    },
    "privacy.presence-bluetooth.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pocket device connecting and disconnecting shows when you take it away from this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随身设备的连接与断开合起来，能看出你什么时候带着它离开这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨身裝置的連線與中斷連線合起來，能看出你什麼時候帶著它離開這台 Mac。"
          }
        }
      }
    },
    "privacy.presence-bluetooth.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; nothing uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用；不上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用；不上傳"
          }
        }
      }
    },
    "privacy.presence-bluetooth.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether your Bluetooth device is nearby"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随身蓝牙设备的在不在"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨身藍牙裝置的在不在"
          }
        }
      }
    },
    "privacy.presence-bluetooth.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks when the device walks away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备走远了就锁屏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置走遠了就鎖定畫面"
          }
        }
      }
    },
    "privacy.presence-bluetooth.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the paired Bluetooth device you picked is connected, and its signal strength while connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选的那台已配对蓝牙设备连没连着，以及连着时的信号强度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選的那台已配對藍牙裝置連沒連著，以及連著時的訊號強度"
          }
        }
      }
    },
    "privacy.presence-bluetooth.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks when the device walks away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备走远就锁屏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置走遠就鎖定畫面"
          }
        }
      }
    },
    "privacy.presence-bluetooth.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lock when you leave switch; clearing the device choice stops it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开就锁的开关；清空随身设备的选择即停"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開就鎖的開關；清空隨身裝置的選擇即停"
          }
        }
      }
    },
    "privacy.private-app-list.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the private app list opens or an entry is added or removed, and when a feature that uses the list runs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“私人 App”、添加或移除时；用到名单的功能触发时读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟“私人 App”、新增或移除時；用到名單的功能觸發時讀"
          }
        }
      }
    },
    "privacy.private-app-list.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private app list with your habits shows which chats and mail you care about protecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私人 App 名单和你的使用习惯合起来，能看出你在意保护哪些聊天和邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
