    "settings.browser.arrangeMenu.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange and undo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
