          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出問題時查原因，也用來看效能"
          }
        }
      }
    },
    "privacy.diagnostics.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
