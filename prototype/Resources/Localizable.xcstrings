    "privacy.diagnostics.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One line is written when an event happens"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生事件时写一行"
          }
        }
      }
    },
    "privacy.diagnostics.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run logs together show which features have been used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行记录合起来，能看出哪些功能被用过。"
          }
        }
      }
    },
    "privacy.diagnostics.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this Mac's Library/Logs/WindowShade folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在这台 Mac 的“资源库/Logs/WindowShade”文件夹里"
          }
        }
      }
    },
    "privacy.diagnostics.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run logs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行记录"
          }
        }
      }
    },
    "privacy.diagnostics.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds the cause of a problem, and shows performance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出问题时查原因，也用来看性能"
          }
        }
      }
    },
    "privacy.diagnostics.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event codes, states and durations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件代号、状态和耗时"
          }
        }
      }
    },
    "privacy.diagnostics.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to find the cause of a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出问题时查原因"
          }
        }
      }
    },
    "privacy.diagnostics.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switch of its own"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有单独的开关"
          }
        }
      }
    },
    "privacy.download-files.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only after you turn on Browser downloads; read on folder changes, never by polling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你打开“浏览器下载”之后；文件夹有变化时才读，没有轮询"
          }
        }
      }
    },
    "privacy.download-files.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filenames of downloads together show what you've been downloading and roughly from where; contents stay invisible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载中的文件名合起来，能看出你最近在下载什么、从哪类网站下；文件内容看不到。"
          }
        }
      }
    },
    "privacy.download-files.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; not sent, not logged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里；不发送，不写运行记录"
          }
        }
      }
    },
    "privacy.download-files.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished downloads in the Downloads folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载文件夹里没下完的文件"
          }
        }
      }
    },
    "privacy.download-files.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how many are downloading and says when one finishes; no file contents, no invented progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示正在下载的个数和下好了的提示；不读文件内容，不编进度"
          }
        }
      }
    },
    "privacy.download-files.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and modification times of unfinished temporary downloads (.crdownload, .download, .part) in the Downloads folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载文件夹里没下完的临时文件（.crdownload、.download、.part）的名字和修改时间"
          }
        }
      }
    },
    "privacy.download-files.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows unfinished downloads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示没下完的文件"
          }
        }
      }
    },
    "privacy.download-files.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser downloads in Live activities (off by default)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动里的“浏览器下载”（默认关）"
          }
        }
      }
    },
    "privacy.drag-kind.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while dragging"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在拖动期间"
          }
        }
      }
    },
    "privacy.drag-kind.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All that's known is what kind of thing you dragged, never its content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只知道你拖的是哪一类，看不出是什么内容。"
          }
        }
      }
    },
    "privacy.drag-kind.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        }
      }
    },
    "privacy.drag-kind.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What kind of thing you're dragging"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拖的是哪一类"
          }
        }
      }
    },
    "privacy.drag-kind.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drops the right landing island as you drag near the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖近刘海时垂下对的落点小岛"
          }
        }
      }
    },
    "privacy.drag-kind.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether you're dragging files, text, images or links, and how many; contents aren't looked at"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拖的是文件、文字、图片还是链接，有几个；不看内容"
          }
        }
      }
    },
    "privacy.drag-kind.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognizes the kind of thing as you drag it near the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖近刘海时认出是哪一类"
          }
        }
      }
    },
    "privacy.drag-kind.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the file shelf"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟着文件架走"
          }
        }
      }
    },
    "privacy.face-identity.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default; once the experiment is on it looks up to 6 seconds when the screen lights up while locked, at up to 10 frames a second; with the head-turn challenge it watches up to 12 more seconds after recognizing; at most 3 times per lock, and an unclear picture doesn't count"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭；打开实验后，锁屏时屏幕亮起最多看 6 秒，每秒最多 10 帧；打开转头挑战，认出后再看最多 12 秒；每次锁屏最多 3 次，画面看不清不算次数"
          }
        }
      }
    },
    "privacy.face-identity.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face features and camera pictures together can tell whether it's you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸特征和摄像头画面合起来，能认出这是不是你。"
          }
        }
      }
    },
    "privacy.face-identity.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates live in this Mac's keychain, not synced and not carried into backups; pictures and crops aren't kept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板只存在这台 Mac 的钥匙串里，不同步、不随备份迁走；画面和裁切图不存"
          }
        }
      }
    },
    "privacy.face-identity.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face features and the comparison result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脸部特征与比对结果"
          }
        }
      }
    },
    "privacy.face-identity.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognizes you after unlocking, keeps one hint, and never unlocks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏后认出是不是你，只留一条证据，不会解锁"
          }
        }
      }
    },
    "privacy.face-identity.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experiment: image features cropped from the face (computed by Apple's Vision), the enrolled template, how open the eyes were at enrolment, the enrolment number and the comparison result; with the head-turn challenge, also which way the face turns and whether the eyes are open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验：脸部裁出来的图像特征（Apple 的 Vision 算出）、登记过的模板、录入时眼睛睁开的程度、录入序号、比对结果；打开转头挑战后，还有转头时脸朝哪边、眼睛睁没睁开"
          }
        }
      }
    },
    "privacy.face-identity.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognizes you after unlocking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏后认出是不是你"
          }
        }
      }
    },
    "privacy.face-identity.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The experiment switch and removing the record; never labelled Face ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验开关和删除登记；不会标成 Face ID"
          }
        }
      }
    },
    "privacy.face-quality.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows face unlock (experimental): it looks only when the screen lights up after locking, up to 6 seconds; screen and phone edges are checked every 3 frames"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟着刷脸解锁（实验）：锁屏后屏幕亮起才看，最多 6 秒；屏幕和手机的边框每 3 帧看一次"
          }
        }
      }
    },
    "privacy.face-quality.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How clear the picture is, with face features, shows whether a real person is in front of the camera or a photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面清不清楚和脸部特征合起来，能看出镜头前是真人还是照片。"
          }
        }
      }
    },
    "privacy.face-quality.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decided in memory; no picture kept, nothing uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里判断，不存画面，不上传"
          }
        }
      }
    },
    "privacy.face-quality.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the face picture is clear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脸部画面清不清楚"
          }
        }
      }
    },
    "privacy.face-quality.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hints at a clearer shot; a held-up photo or phone counts as no match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示怎么拍得更清楚；看出有人举着照片或手机，就算没认出"
          }
        }
      }
    },
    "privacy.face-quality.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experiment: how clear and bright the face picture is, whether it glares, and whether a screen or phone edge appears in it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验：脸部画面清不清楚、亮不亮、有没有反光，画面里有没有屏幕或手机的边框"
          }
        }
      }
    },
    "privacy.face-quality.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether a real person is in front of the camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看清镜头前是不是真人"
          }
        }
      }
    },
    "privacy.face-quality.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The face unlock (experimental) switch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷脸解锁（实验）的开关"
          }
        }
      }
    },
    "privacy.file-shelf.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded only when you drop on Park; the shelf is checked on open, at startup and on disk changes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你松在“暂存”上时记；打开文件架、启动、接拔磁盘时检查还在不在"
          }
        }
      }
    },
    "privacy.file-shelf.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names on the file shelf together show what you've been busy with."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件架上的名字合起来，能看出你最近在忙什么。"
          }
        }
      }
    },
    "privacy.file-shelf.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this Mac only: ~/Library/Application Support/WindowShade/File Shelf/; not sent, not logged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在这台 Mac：~/Library/Application Support/WindowShade/文件架/；不发送，不写运行记录"
          }
        }
      }
    },
    "privacy.file-shelf.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you put on the file shelf"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放进文件架的东西"
          }
        }
      }
    },
    "privacy.file-shelf.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still on the shelf next time: drag out, preview, AirDrop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次还在文件架上：拖出去、预览、隔空投送"
          }
        }
      }
    },
    "privacy.file-shelf.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the files you put on the shelf are and what they're called; the text, images and links you drag in themselves"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你放进文件架的文件在哪、叫什么；拖进来的文字、图片、链接本身"
          }
        }
      }
    },
    "privacy.file-shelf.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembers what you put aside"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住你暂存的东西"
          }
        }
      }
    },
    "privacy.file-shelf.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings > Notch > File shelf (on by default; turning it off clears it)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 > 刘海 > 文件架（默认开，关掉即清空）"
          }
        }
      }
    },
    "privacy.focus-preferences.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Settings opens, an option changes or a countdown starts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置、改选项或开始计时时"
          }
        }
      }
    },
    "privacy.focus-preferences.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus timer lengths with whether chat is tucked into the notch show the rhythm of your work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄钟的时长和是否把聊天收进刘海合起来，能看出你的工作节奏。"
          }
        }
      }
    },
    "privacy.focus-preferences.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this Mac; never sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在这台 Mac 上，不发送"
          }
        }
      }
    },
    "privacy.focus-preferences.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus timer settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄钟的设置"
          }
        }
      }
    },
    "privacy.focus-preferences.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts down the length you picked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你选的时长计时"
          }
        }
      }
    },
    "privacy.focus-preferences.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus lengths (25/5 or 50/10) and Tuck chat into the notch during Focus"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注时长（25/5 或 50/10）和“专注时把聊天收进刘海”"
          }
        }
      }
    },
    "privacy.focus-preferences.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus timer length and options"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄钟的时长和选项"
          }
        }
      }
    },
    "privacy.focus-preferences.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The focus timer's two rows in Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的番茄钟两项"
          }
        }
      }
    },
    "privacy.focus-window-receipts.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once rolling up is ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口收起功能就绪之后"
          }
        }
      }
    },
    "privacy.focus-window-receipts.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles of windows rolled up during Focus together show what this stretch of work is about."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注时收起的窗口标题合起来，能看出你这一轮在做什么。"
          }
        }
      }
    },
    "privacy.focus-window-receipts.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; only the current round"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里，只留当前这一轮"
          }
        }
      }
    },
    "privacy.focus-window-receipts.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window ownership recorded by the focus timer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄钟记下的窗口归属"
          }
        }
      }
    },
    "privacy.focus-window-receipts.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts back only the windows the focus timer rolled up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束后，只放回番茄钟自己收起的窗口"
          }
        }
      }
    },
    "privacy.focus-window-receipts.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ids, owning apps and titles of rolled-up windows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起的窗口的编号、所属 App 和标题"
          }
        }
      }
    },
    "privacy.focus-window-receipts.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only puts back windows it rolled up itself"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只放回自己收起的窗口"
          }
        }
      }
    },
    "privacy.focus-window-receipts.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the focus timer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟着番茄钟"
          }
        }
      }
    },
    "privacy.game-controller.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you turn it on; the trigger clears at once when the screen locks, a connection drops or another app takes over"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你开启之后；锁屏、断线、被抢占时立刻清掉扳机"
          }
        }
      }
    },
    "privacy.game-controller.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A controller's buttons and sticks together show when you play and how much."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄的按键和摇杆合起来，能看出你什么时候在用手柄、用得多不多。"
          }
        }
      }
    },
    "privacy.game-controller.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input stays in memory; feedback goes to the controller you chose, with no commands cached across sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入只在内存里；反馈发回你选的手柄，不跨会话缓存指令"
          }
        }
      }
    },
    "privacy.game-controller.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller input and feedback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄输入和反馈"
          }
        }
      }
    },
    "privacy.game-controller.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllers share actions with other input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄和别的输入共用同一套动作"
          }
        }
      }
    },
    "privacy.game-controller.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A controller's number, d-pad and buttons, touchpad input, and trigger feedback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄的编号、方向键和按钮、触控板输入，以及扳机的阻力反馈"
          }
        }
      }
    },
    "privacy.game-controller.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlling with a controller"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手柄操作"
          }
        }
      }
    },
    "privacy.game-controller.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller input; unrelated controllers are left alone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄输入；不抢无关的手柄"
          }
        }
      }
    },
    "privacy.group.不用问就能读的.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On for every app by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统给每个 App 都开着"
          }
        }
      }
    },
    "privacy.group.不用问就能读的.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read without asking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用问就能读的"
          }
        }
      }
    },
    "privacy.group.你同意后才读的.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system asks first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统会先问你"
          }
        }
      }
    },
    "privacy.group.你同意后才读的.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read only after you agree"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你同意后才读的"
          }
        }
      }
    },
    "privacy.group.去了哪里.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where it goes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去了哪里"
          }
        }
      }
    },
    "privacy.group.用了系统没公开的方法的.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple doesn't document it and a system update may break it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 没写进文档，系统更新后可能失效"
          }
        }
      }
    },
    "privacy.group.用了系统没公开的方法的.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses methods the system doesn't document"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用了系统没公开的方法的"
          }
        }
      }
    },
    "privacy.headphone-motion.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only with the developer switch on and the silent-actions page open; stops when the page closes, headphones disconnect or the screen locks; callbacks come only on new poses, with no timer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在开发者开关打开、静音操作页开着时读；页面关掉、耳机断开、锁屏就停；系统有新姿态才回调，没有定时器"
          }
        }
      }
    },
    "privacy.headphone-motion.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head movement from headphones, with the display you're looking at, shows which screen has your attention and whether you nod or shake your head."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耳机的头部朝向和你正在看的屏幕合起来，能看出你在看哪块屏、有没有点头或摇头。"
          }
        }
      }
    },
    "privacy.headphone-motion.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; nothing saved or uploaded; a run-only number tells one set of headphones from another"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存；不保存、不上传；不记耳机名字或标识，只用一个本次运行有效的序号区分是不是换了一副"
          }
        }
      }
    },
    "privacy.headphone-motion.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head movement from headphones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耳机头动"
          }
        }
      }
    },
    "privacy.headphone-motion.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nod to confirm, shake to cancel in silent actions; no speaking, no camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音操作里用点头确认、摇头取消；不用说话，也不用相机"
          }
        }
      }
    },
    "privacy.headphone-motion.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head orientation from AirPods (pitch and turn), turned into degrees in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods 的头部朝向（俯仰、左右转），只在内存里换算成度数"
          }
        }
      }
    },
    "privacy.headphone-motion.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nod to confirm, shake to cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点头确认，摇头取消"
          }
        }
      }
    },
    "privacy.headphone-motion.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A developer switch (not in Settings yet); needs the system's Motion & Fitness permission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者开关（目前不在设置里），需要系统的“动作与健身”权限"
          }
        }
      }
    },
    "privacy.hid-remapping.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves and applies when you turn it on, and restores the difference when you undo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你开启时保存并应用，撤销时还原差异"
          }
        }
      }
    },
    "privacy.hid-remapping.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key mappings show what you changed on the remote, never what you pressed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键映射合起来，能看出你给遥控器改过哪些键，看不出你按过什么。"
          }
        }
      }
    },
    "privacy.hid-remapping.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written to the system's key mapping; ownership records hold no input history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写在系统的按键映射里；归属记录不含输入历史"
          }
        }
      }
    },
    "privacy.hid-remapping.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote button mapping"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器按键映射"
          }
        }
      }
    },
    "privacy.hid-remapping.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the system's action from firing twice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免系统的动作和 WindowShade 重复响应"
          }
        }
      }
    },
    "privacy.hid-remapping.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system's current key mappings, and the few WindowShade adds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统现在的按键映射，和只由 WindowShade 加的几条"
          }
        }
      }
    },
    "privacy.hid-remapping.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoids reacting twice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免重复响应"
          }
        }
      }
    },
    "privacy.hid-remapping.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode; mappings other tools added stay as they are"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式；不覆盖别的工具加的映射"
          }
        }
      }
    },
    "privacy.hinge.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Desktop lid is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面开合开着时"
          }
        }
      }
    },
    "privacy.hinge.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lid angle with the lock state shows when you opened or closed this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕开合的角度加上锁屏状态，能看出你什么时候合上或打开了这台 Mac。"
          }
        }
      }
    },
    "privacy.hinge.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        }
      }
    },
    "privacy.hinge.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The angle of the display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕开合的角度"
          }
        }
      }
    },
    "privacy.hinge.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop folds into the notch as the lid closes, following your hand; with no reading, no effect is drawn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上时桌面折进刘海，跟着手走；读不到就不画这个效果"
          }
        }
      }
    },
    "privacy.hinge.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far the lid is open right now"
          }
        },
