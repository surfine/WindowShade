    "welcome.flow.introLede": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a Windows shortcut does nothing, the notch says which Mac key to use. When things go smoothly, it stays quiet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按了 Windows 的快捷键没反应时，刘海说一句 Mac 上按哪一下。顺利的时候，它不出声。"
          }
        }
      }
    },
    "welcome.flow.introTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just switched to a Mac? Start at the notch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚换 Mac？从刘海开始。"
          }
        }
      }
    },
    "welcome.flow.note.ipad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a Mac, a two-finger tap opens menus, just like an iPad trackpad. The notch speaks up when you get stuck."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上，菜单要两指点按，和 iPad 接触控板时一样。卡住时刘海会说。"
          }
        }
      }
    },
    "welcome.flow.note.mac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then the notch will mostly stay quiet. You can change this anytime in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那刘海多半不会开口。设置里随时能改。"
          }
        }
      }
    },
    "welcome.flow.note.unanswered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one and the notch teaches to your habits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一个，刘海按你的习惯来教。"
          }
        }
      }
    },
    "welcome.flow.note.windows": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy and paste are ⌘ under your thumb, right where Alt used to be. The notch covers the rest when you get stuck."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝、粘贴用拇指按 ⌘，就在你原来按 Alt 的地方。其余的，卡住时刘海会说。"
          }
        }
      }
    },
    "welcome.flow.originTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What did you use before?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你之前常用哪个？"
          }
        }
      }
    },
    "welcome.flow.pageLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %@ 页"
          }
        }
      }
    },
    "welcome.flow.permissionLede": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility lets WindowShade move windows, and Screen Recording lets it show live previews. Turn both on and you’re set."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能让 WindowShade 能移动窗口，屏幕录制让它能显示实时画面。两项都打开就能用了。"
          }
        }
      }
    },
    "welcome.flow.permissionTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last step: permissions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后一步：授权"
          }
        }
      }
    },
    "welcome.flow.picture.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation: ⌃C does nothing, so the notch opens and says “On a Mac, Copy is ⌘C”; ⌘C works and the notch folds away; then ⌘V drops that line into Mail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画：按了 ⌃C 没有反应，刘海展开说“Mac 上拷贝按 ⌘C”；按了 ⌘C，刘海收回；再按 ⌘V，那句话落进邮件。"
          }
        }
      }
    },
    "welcome.flow.picture.origin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustration: with Windows picked, the four keycaps at the lower left become the Mac keys fn, control, option, and command."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示意图：选了 Windows，左下角四颗键帽换成 Mac 上的 fn、control、option、command。"
          }
        }
      }
    },
    "welcome.progress.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ permission step(s) to go · %@ / 2 done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还差%@步权限 · %@ / 2 已完成"
          }
        }
      }
    },
