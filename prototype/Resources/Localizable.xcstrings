    "privacy.input-gamepad.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
