    "presence.risk.row.battery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It also locks when the phone is dead, Bluetooth is off, or it's in another room"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机没电、关了蓝牙或放在别的房间，也会锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機沒電、關了藍牙或放在別的房間，也會鎖"
          }
        }
      }
    },
    "presence.risk.row.lock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It only locks; it never unlocks for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只锁屏，不替你解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只鎖定畫面，不替你解鎖"
          }
        }
      }
    },
    "presence.risk.row.phone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether your phone is reachable and answering"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看你的手机连不连得上、有没有回应"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看你的手機連不連得上、有沒有回應"
          }
        }
      }
    },
    "presence.risk.row.tap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch the keyboard or trackpad during the countdown to cancel it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒数时碰一下键盘或触控板就不锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倒數時碰一下鍵盤或觸控式軌跡板就不鎖"
          }
        }
      }
    },
    "presence.risk.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What locking when you leave does"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开就锁会这样做"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開就鎖會這樣做"
          }
        }
      }
    },
    "presence.tapToCancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch it to cancel the lock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
