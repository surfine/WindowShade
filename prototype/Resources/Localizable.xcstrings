    "settings.input.fine.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With ⌥ held, one scroll moves a single line. Needs Smooth scrolling or Mouse scroll direction on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 时，一条滚动只走一行。要和平滑滚动或鼠标滚动方向一起开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 時，一條捲動只走一行。要和平滑捲動或滑鼠捲動方向一起開。"
          }
        }
      }
    },
