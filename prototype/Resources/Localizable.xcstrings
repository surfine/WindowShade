    "settings.shade.levelKeys.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press volume, brightness or keyboard-light keys and the notch shows a bar on each side while macOS's overlay stays hidden. On the lock screen and in Mission Control, macOS's overlay still shows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按音量、亮度、键盘灯键时，刘海两边显示一条，系统自己的提示藏起来。锁屏和调度中心里仍是系统的提示。"
          }
        }
      }
    },
    "settings.shade.levelKeys.infoMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on WindowShade in Accessibility to hide macOS's overlay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“辅助功能”里打开 WindowShade，系统自己的提示就会藏起来。"
          }
        }
      }
    },
    "settings.shade.levelKeys.infoUnverified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This macOS version isn't verified yet, so macOS's overlay shows as well."
