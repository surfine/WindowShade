    },
    "privacy.remote-hid.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Remote mode on and a source bound; a disconnect cancels every key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式开着并绑定了来源；断线就取消所有按键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控模式開著並綁定了來源；斷線就取消所有按鍵"
          }
        }
      }
    },
    "privacy.remote-hid.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote buttons show when you use the remote and which keys you reach for."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器的按钮合起来，能看出你什么时候在用遥控器、常按哪些键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控器的按鈕合起來，能看出你什麼時候在用遙控器、常按哪些鍵。"
          }
        }
      }
    },
    "privacy.remote-hid.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; the mapping's ownership record stays on this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里；映射的归属记录只存在这台 Mac 上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡；對映的歸屬記錄只存在這台 Mac 上"
          }
        }
      }
    },
    "privacy.remote-hid.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote buttons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
