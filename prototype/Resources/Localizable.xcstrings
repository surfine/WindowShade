      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to read this step while conducting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥时看这一笔"
          }
        }
