          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機身往哪邊傾斜、有沒有在動"
          }
        }
      }
    },
    "privacy.tilt.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The light and shadow in the lid effect"
          }
        },
        "zh-Hans": {
