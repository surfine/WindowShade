          "stringUnit": {
            "state": "translated",
            "value": "Top right"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右上角"
          }
        }
      }
    },
    "privacy.agent-hooks.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After turning on Coding sessions and pasting the configuration into Claude Code; off by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“编程会话”、把配置粘贴进 Claude Code 之后；默认关"
          }
        }
      }
    },
    "privacy.agent-hooks.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding assistant events show which project you're on and when you write code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编程助手的事件合起来，能看出你在做哪个项目、什么时候在写代码。"
          }
        }
      }
    },
    "privacy.agent-hooks.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrives over a local connection on this Mac, not the internet; in memory, forgotten when switched off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只经这台 Mac 上的本机连接收，不联网；只在内存里，关掉就忘"
          }
        }
      }
    },
    "privacy.agent-hooks.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding assistant events"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编程助手的事件"
          }
        }
      }
    },
    "privacy.agent-hooks.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows whether Claude Code is running or waiting for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海里看 Claude Code 在跑还是在等你"
          }
        }
      }
    },
    "privacy.agent-hooks.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code session ids, folder names, tool names in use and events; command contents and conversations are not read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 的会话编号、所在文件夹的名字、正在用的工具名和事件；不读命令内容和对话"
          }
        }
      }
    },
    "privacy.agent-hooks.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the coding assistant's state in the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编程助手的状态放到刘海"
          }
        }
      }
    },
    "privacy.agent-hooks.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding sessions (in Conductor's settings); turning it off stops receiving and drops the local connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编程会话（在指挥模式设置里）；关掉就停止接收，删掉本机连接"
          }
        }
      }
    },
    "privacy.agent-voice-proof.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only after the approval has been shown and you confirm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经展示了审批、你又确认之后才发起"
          }
        }
      }
    },
    "privacy.agent-voice-proof.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound of the approval phrase, taken together, can tell whether it's your voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批口令的声音合起来，能辨认这是不是你的声音。"
          }
        }
      }
    },
    "privacy.agent-voice-proof.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept briefly in memory for this one request; no full recording log"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短期留在内存里，只对应这一次请求；不写完整的录音日志"
          }
        }
      }
    },
    "privacy.agent-voice-proof.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval passphrases and voice hints"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批口令和声纹辅助证据"
          }
        }
      }
    },
    "privacy.agent-voice-proof.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A supporting hint for high-risk actions; not a permission by itself"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高风险操作的辅助证据；它本身不是放行的权限"
          }
        }
      }
    },
    "privacy.agent-voice-proof.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcription of one random passphrase, and the result of the supporting check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次随机口令的转写，和辅助比对的结果"
          }
        }
      }
    },
    "privacy.agent-voice-proof.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passphrase for high-risk actions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高风险操作的辅助口令"
          }
        }
      }
    },
    "privacy.agent-voice-proof.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no reliable voiceprint the usual identity path is used"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可靠的声纹时，沿用现有的主身份路径"
          }
        }
      }
    },
    "privacy.airdrop-send.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when you drop on AirDrop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你松在“隔空投送”上时"
          }
        }
      }
    },
    "privacy.airdrop-send.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All that's known is that you handed something over and whether it worked — not who received it, and no filename is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只知道你投过东西、成没成，不知道发给了谁，也不留文件名。"
          }
        }
      }
    },
    "privacy.airdrop-send.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed to the system's AirDrop; we don't see who received it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交给系统的隔空投送；我们不知道发给了谁"
          }
        }
      }
    },
    "privacy.airdrop-send.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you hand to AirDrop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交给隔空投送的东西"
          }
        }
      }
    },
    "privacy.airdrop-send.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands files straight to nearby devices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把文件直接投给附近的设备"
          }
        }
      }
    },
    "privacy.airdrop-send.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only hands things over, reads nothing; all that's known is whether it worked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只交出去，不读；只知道成没成"
          }
        }
      }
    },
    "privacy.airdrop-send.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands things to AirDrop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把东西交给隔空投送"
          }
        }
      }
    },
    "privacy.airdrop-send.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switch of its own"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有单独的开关"
          }
        }
      }
    },
    "privacy.app-uninstall.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans only when you pick Uninstall App… in the app's context menu; the switch is off by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在这个 App 的右键菜单里点「卸载 App…」才扫；功能开关默认关"
          }
        }
      }
    },
    "privacy.app-uninstall.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The uninstall file list together shows what this app left behind on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载的文件清单合起来，能看出这个 App 在这台 Mac 上留下过什么。"
          }
        }
      }
    },
    "privacy.app-uninstall.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list shows only in the uninstall panel; files go to the Trash, nothing is uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清单只在卸载浮层里给你看；文件进废纸篓，不上传"
          }
        }
      }
    },
    "privacy.app-uninstall.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Related files seen when uninstalling an app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载 App 时读到的关联文件"
          }
        }
      }
    },
    "privacy.app-uninstall.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves the app and its related files to the Trash (recoverable)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 App 和它的关联文件一起移到废纸篓（可找回）"
          }
        }
      }
    },
    "privacy.app-uninstall.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list of user-domain files belonging to the app you're uninstalling (preferences, application support, caches, window state, containers, launch agents and the like) and their sizes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你右键要卸载的那个 App 的用户域关联文件清单（偏好、应用支持、缓存、窗口状态、容器、启动代理等）和它们的大小"
          }
        }
      }
    },
    "privacy.app-uninstall.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalling takes its files to the Trash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删 App 连文件进废纸篓"
          }
        }
      }
    },
    "privacy.app-uninstall.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Launchpad uninstall switch; each run asks for a tick, and unticked items are left alone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动台卸载的开关；每次还有勾选确认，不勾的不动"
          }
        }
      }
    },
    "privacy.audio-outputs.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current device type is read once when the card opens; everything is read when you pick Play to; no permanent listener and no timers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开正在播放的大卡时读一次当前设备的类型；点“播放到”时读一次全部；没有常驻监听，不定时去读"
          }
        }
      }
    },
    "privacy.audio-outputs.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device names together show which headphones and speakers you own, some carrying your name; never what you're listening to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设备名合起来，能看出你有哪些耳机和音箱，有的还带着你的名字；看不出你在听什么。"
          }
        }
      }
    },
    "privacy.audio-outputs.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; device names stay out of the logs; picking one only switches the system's default output"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里，设备名不写进运行记录，不发送；你选定后，只把系统默认输出换成那一个"
          }
        }
      }
    },
    "privacy.audio-outputs.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound output devices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音输出设备"
          }
        }
      }
    },
    "privacy.audio-outputs.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks where sound comes out in the Now Playing card, and tells headphones, speakers and this Mac apart by icon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在正在播放的大卡上，选声音从哪里出来，并按图标认出现在用的是耳机、音箱还是这台 Mac"
          }
        }
      }
    },
    "privacy.audio-outputs.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and types of the output devices offered in the system's Sound settings, and which one is current; device names may carry your name, like “Alex's AirPods”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统“声音”里能选的输出设备的名字、类型和哪一个是当前的；设备名里可能有你的名字，比如“小明的 AirPods”"
          }
        }
      }
    },
    "privacy.audio-outputs.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick where the sound comes out, in the card"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大卡里选声音从哪里出来"
          }
        }
      }
    },
    "privacy.audio-outputs.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Now Playing off in Settings and the card won't open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的“正在播放”关掉，大卡就不会开"
          }
        }
      }
    },
    "privacy.authorization-key.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each time you explicitly approve; locking and the like void older approvals"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次你明确授权时；锁屏等情况会让旧的授权作废"
          }
        }
      }
    },
    "privacy.authorization-key.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often and when the authorization key is used shows when you've approved things."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权密钥的使用次数和时间合起来，能看出你什么时候批准过操作。"
          }
        }
      }
    },
    "privacy.authorization-key.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In WindowShade's authorization folder on this Mac, not the keychain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放在这台 Mac 上 WindowShade 的授权文件夹里，没有写进钥匙串"
          }
        }
      }
    },
    "privacy.authorization-key.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device authorization keys"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备授权密钥"
          }
        }
      }
    },
    "privacy.authorization-key.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each approval covers one thing and is valid once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次授权只对一件事、只有一次有效"
          }
        }
      }
    },
    "privacy.authorization-key.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The public half of a key the Mac's security chip protects, the result of its use, and a one-off challenge; the private key can't be exported"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 安全芯片保护的密钥的公钥、使用结果和一次性的挑战；私钥导不出来"
          }
        }
      }
    },
    "privacy.authorization-key.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each approval covers one thing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次授权只管一件事"
          }
        }
      }
    },
    "privacy.authorization-key.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the record; the safety check can't be skipped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除登记；安全校验不能跳过"
          }
        }
      }
    },
    "privacy.battery.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this Mac's power changes (pushed, no more polling), and when an accessory connects or disconnects; connected accessories are read every 2 minutes; AirPods are read once when they become the output and at most every 10 minutes after"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的电源变化时（系统推送，不再定时读）；配件连上、断开时；已连着的配件每 2 分钟读一次；AirPods 成为声音输出时读一次，之后最多 10 分钟一次"
          }
        }
      }
    },
    "privacy.battery.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory models and battery together show which accessories you use and how long since they were charged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配件的型号和电量合起来，能看出你用哪些配件、多久没充电。"
          }
        }
      }
    },
    "privacy.battery.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery stays in memory; a warned low battery is remembered on this Mac to avoid repeating"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量只在内存里用；提醒过的低电量记在这台 Mac 的设置里，免得重复提醒"
          }
        }
      }
    },
    "privacy.battery.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory battery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配件电量"
          }
        }
      }
    },
    "privacy.battery.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notch says a word when an accessory connects or runs low"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配件连上或电量低时，刘海说一句"
          }
        }
      }
    },
    "privacy.battery.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac's battery level, whether it's plugged in, whether it's full and Low Power Mode; names and battery levels of connected accessories; with AirPods connected to this Mac, the levels of the left bud, right bud and case"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的电量、有没有插电、是否已充满、低电量模式；已连接配件的名字和电量；AirPods 连在这台 Mac 上时，读左耳、右耳、充电盒的电量"
          }
        }
      }
    },
    "privacy.battery.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Mouse, keyboard, trackpad, headphones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "妙控鼠标、键盘、触控板、耳机"
          }
        }
      }
    },
    "privacy.battery.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switch in Settings yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里目前没有单独的开关"
          }
        }
      }
    },
    "privacy.bluetooth-presence.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the feature on and the Bluetooth check passed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功能开着、蓝牙检查通过之后"
          }
        }
      }
    },
    "privacy.bluetooth-presence.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pocket device connecting and disconnecting, with the lock state, shows when you leave your seat and when you come back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随身设备的连接和断开，合上锁屏状态，能看出你什么时候离开座位、什么时候回来。"
          }
        }
      }
    },
    "privacy.bluetooth-presence.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; no path is kept and device names are never identity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里，不留轨迹；设备的名字不当作身份"
          }
        }
      }
    },
    "privacy.bluetooth-presence.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether your pocket device is around"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随身设备是否在场"
          }
        }
      }
    },
    "privacy.bluetooth-presence.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells Lock when you leave whether you're away or back; signal strength is never identity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给“离开就锁”判断你是离开了还是回来了；信号强弱不当作身份"
          }
        }
      }
    },
    "privacy.bluetooth-presence.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired devices' identifiers, connects and disconnects, and signal strength"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对设备的标识、连上或断开、信号强弱"
          }
        }
      }
    },
    "privacy.bluetooth-presence.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works out whether you've walked away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "判断你是不是走开了"
          }
        }
      }
    },
    "privacy.bluetooth-presence.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock when you leave; turning it off stops the listening"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开就锁；关掉就停止监听"
          }
        }
      }
    },
    "privacy.calendar.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At launch (if granted), on calendar changes and before each event (1 / 5 / 10 / 15 minutes, 5 by default); only the next 24 hours; a one-shot timer is set only when there's something to count down, ticking each second in the last minute and while the card is open, never polled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时（已允许的话）、日历有改动时、每个日程开始前（设置里选 1 / 5 / 10 / 15 分钟，默认 5）；只查未来 24 小时；有日程要倒数时才挂一次性定时器，最后一分钟和日程大卡开着时每秒换一次字，平时不轮询"
          }
        }
      }
    },
    "privacy.calendar.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event times, titles and places together show when and where you meet, and with whom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程的时间、标题和地点合起来，能看出你什么时候在哪、和谁开会。"
          }
        }
      }
    },
    "privacy.calendar.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; notes are dropped once read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里，不存，不外发；备注读完就扔"
          }
        }
      }
    },
    "privacy.calendar.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程"
          }
        }
      }
    },
    "privacy.calendar.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notch counts down before a meeting, and can join when there's a link"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快开会时，刘海提前倒数提醒；有会议链接时可以直接加入"
          }
        }
      }
    },
    "privacy.calendar.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start and end times, titles, places, links and notes of events in the next 24 hours (searched only for meeting links), your reply status, and calendar colours"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来 24 小时内日程的开始和结束时间、标题、地点、链接、备注（只在里面找会议链接）、你的回复状态、日历颜色"
          }
        }
      }
    },
    "privacy.calendar.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you just before a meeting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快开会时提醒你"
          }
        }
      }
    },
    "privacy.calendar.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Calendar switch in Settings, off by default; the welcome screen's step three and the system prompt both have to agree first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的「日程」开关，默认关；欢迎窗口第三步点「允许」、再在系统弹窗里同意后才读"
          }
        }
      }
    },
    "privacy.camera-frame.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect face motion starts only when you pick it in the menu. Watching starts once apps are listed and you've been still for 30 seconds, at two frames a second, and stops on any keyboard or mouse input. Both stop while locked, asleep or switching users. Recognize you (experiment, off by default) starts when the screen lights up after locking, at up to 10 frames a second for 6 seconds, at most 3 times per lock; with the head-turn challenge it watches up to 12 more seconds after recognizing; it stops on sleep and user switches"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测面部动作：你在菜单里选了才开。有人在看：私人 App 里选了 App、你停手满 30 秒才开，每秒只看 2 帧，一碰键盘鼠标就关。这两样在锁屏、睡眠、切换用户时都停。认出你（实验，默认关）：锁屏后屏幕亮起才开，每秒最多 10 帧，最多看 6 秒，每次锁屏最多 3 次；打开转头挑战，认出后再看最多 12 秒；睡眠、切换用户时停"
          }
        }
      }
    },
    "privacy.camera-frame.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera pictures with the lock state show whether you're at your desk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头画面和锁屏状态合起来，能看出你在不在座位上。"
          }
        }
      }
    },
    "privacy.camera-frame.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to decide, never uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来判断，不上传"
          }
        }
      }
    },
    "privacy.camera-frame.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头"
          }
        }
      }
    },
    "privacy.camera-frame.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Detect face motion on it watches blinks and head turns; with Roll up private windows while someone's watching it checks for someone facing the screen; with the recognition experiment it checks whether it's you while locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在菜单里选“检测面部动作”时，看你眨眼或转头；打开“有人在看时收起私人窗口”后，看有没有别人正对屏幕，有就把私人窗口收进刘海；打开认出你的实验后，锁屏时看是不是你"
          }
        }
      }
    },
    "privacy.camera-frame.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In what the camera sees: which way the face turns, whether the eyes are open, and whether someone else faces the screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头拍到的画面里，脸朝哪边、眼睛睁没睁开、有没有别人正对屏幕"
          }
        }
      }
    },
    "privacy.camera-frame.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinks, head turns and whether someone is watching"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眨眼、转头和有人在看"
          }
        }
      }
    },
    "privacy.camera-frame.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll up private windows while someone's watching, plus the camera permission in System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“有人在看时收起私人窗口”，以及系统设置里的摄像头授权"
          }
        }
      }
    },
    "privacy.carplay-receiver.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects only with CarPlay full screen on and a receiver address entered; off by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay 全屏开着且你填了接收器地址才连；默认关"
          }
        }
      }
    },
    "privacy.carplay-receiver.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receiver connections show when you put a phone's picture full screen on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收器连接合起来，能看出你什么时候把手机画面放到这台 Mac 的全屏里。"
          }
        }
      }
    },
    "privacy.carplay-receiver.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects only to the receiver address you entered; the picture decodes here and touches and keys go back to it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只连你填的接收器地址；画面在这台 Mac 上解码显示，触摸和按键也只发给它"
          }
        }
      }
    },
    "privacy.carplay-receiver.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An external receiver CarPlay connects to full screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay 全屏连的外部接收器"
          }
        }
      }
    },
    "privacy.carplay-receiver.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the iPhone's CarPlay picture in the notch full screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海全屏里显示 iPhone 的 CarPlay 画面"
          }
        }
      }
    },
    "privacy.carplay-receiver.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone picture sent by the receiver you entered, its picture parameters and the session state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你填的那台接收器送来的 iPhone 画面、画面参数和会话状态"
          }
        }
      }
    },
    "privacy.carplay-receiver.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone's picture comes through the receiver"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 的画面从接收器来"
          }
        }
      }
    },
    "privacy.carplay-receiver.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no receiver address it shows a sample picture; clearing the address disconnects"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不填接收器地址就只看示意画面；清掉地址即不连"
          }
        }
      }
    },
    "privacy.codex-server.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read only while bound to a session; the first connection takes the current state once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在绑定会话时读；第一次连上先取一次现状"
          }
        }
      }
    },
    "privacy.codex-server.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex's sessions and approvals together show what you're working on and what you've approved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 的会话和审批合起来，能看出你在做什么项目、批准过哪些操作。"
          }
        }
      }
    },
    "privacy.codex-server.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local service on this Mac; later Codex calls may send what you submit to the provider"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的本机服务；之后的 Codex 调用可能把你提交的内容发给提供商"
          }
        }
      }
    },
    "privacy.codex-server.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex sessions and approvals"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 会话和审批"
          }
        }
      }
    },
    "privacy.codex-server.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends what you explicitly submit and shows the real receipt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送你明确提交的内容，并显示真实的回执"
          }
        }
      }
    },
    "privacy.codex-server.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available models, session and approval-request states, the quota a session reports (how much is left, when it resets), and the least text you submit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用的模型、会话和审批请求的状态，会话自己报来的额度（还剩多少、什么时候恢复），以及你提交的最少文字"
          }
        }
      }
    },
    "privacy.codex-server.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends what you submit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送你提交的内容"
          }
        }
      }
    },
    "privacy.codex-server.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor ties to one session; it doesn't read arbitrary history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥模式和会话绑定；不读任意的历史全文"
          }
        }
      }
    },
    "privacy.command-review.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the assistant asks; it expires after 30 seconds or on disconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手提出请求时；30 秒后或断线就失效"
          }
        }
      }
    },
    "privacy.command-review.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full commands and the working directory together show which project you're on and what you changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整命令和工作目录合起来，能看出你在做哪个项目、改了什么。"
          }
        }
      }
    },
    "privacy.command-review.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local authentication and authorization records on this Mac; no command log"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的本机认证和授权记录；不写命令日志"
          }
        }
      }
    },
    "privacy.command-review.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command approvals"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令审批"
          }
        }
      }
    },
    "privacy.command-review.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approves this one command once; file and rule approvals are separate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只批准这一条命令一次；文件和规则的审批另算"
          }
        }
      }
    },
    "privacy.command-review.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete commands, the working directory, session context and a one-off review snapshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的命令、工作目录、会话背景和一次性的审阅快照"
          }
        }
      }
    },
    "privacy.command-review.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approves one command at a time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准一条命令一次"
          }
        }
      }
    },
    "privacy.command-review.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval appears only when it's asked for; it can't be skipped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批只在有请求时出现；不能跳过"
          }
        }
      }
    },
    "privacy.conductor-audio.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Conductor on and the side button held"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥模式打开，并且按住侧边按钮时"
          }
        }
      }
    },
    "privacy.conductor-audio.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound while you hold, taken together, shows what you said and may reveal whether it was you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住时的声音合起来，能看出你说了什么，也可能听出是不是你。"
          }
        }
      }
    },
    "privacy.conductor-audio.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不读取"
          }
        }
      }
    },
    "privacy.conductor-audio.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound while the side button is held"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住侧边按钮时的声音"
          }
        }
      }
    },
    "privacy.conductor-audio.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let go to get a draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开后得到草稿"
          }
        }
      }
    },
    "privacy.conductor-audio.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound while the side button is held; the transcription is discarded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住侧边按钮时的声音；转写后丢弃"
          }
        }
      }
    },
    "privacy.conductor-audio.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold and speak to get a draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话得到草稿"
          }
        }
      }
    },
    "privacy.conductor-audio.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥模式"
          }
        }
      }
    },
    "privacy.conductor-ipc.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you explicitly bind it; locking, sleeping or undoing ends it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你明确绑定之后；锁屏、睡眠、撤销都会关掉"
