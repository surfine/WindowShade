    "settings.shade.trackpad.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title bar gestures"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题栏手势"
          }
        }
      }
    },
    "settings.shade.trackpad.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-finger swipe, scroll, or flick on a title bar: up to roll up, down to fill"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在标题栏上两指滑动、滚动滚轮或拖着甩一下：往上收起，往下铺满"
          }
        }
      }
    },
    "settings.shade.trackpad.subSwish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swish is running and takes the title-bar gestures; swiping down on the bar still unrolls"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Swish 正在运行，标题栏上的手势交给它；在卷帘条上往下滑仍可展开"
          }
        }
      }
    },
    "settings.shade.translucent.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More see-through, so what's behind shows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让它更透一些，能看到后面的内容"
          }
        }
      }
    },
    "settings.shade.tuckNotch.name": {
