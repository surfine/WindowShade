    "settings.input.sideButtons.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons 4 and 5 become Back and Forward for the app in front. Needs Smooth scrolling or Mouse scroll direction on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧键 4、5 准备用作这个 App 的后退和前进。要和平滑滚动或鼠标滚动方向一起开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "側鍵 4、5 準備用作這個 App 的後退和前進。要和平滑捲動或滑鼠捲動方向一起開。"
          }
        }
      }
    },
