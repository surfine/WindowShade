          "stringUnit": {
            "state": "translated",
            "value": "只留當前這一筆，最多 2048 個點"
          }
        }
      }
    },
    "privacy.remote-touch.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote's touch area"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器触控区域"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控器觸控區域"
          }
        }
      }
    },
    "privacy.remote-touch.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path input in Conductor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥模式里的轨迹输入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指揮模式裡的軌跡輸入"
          }
        }
      }
    },
    "privacy.remote-touch.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordinates and times on the remote's touch area; nothing is invented from ordinary buttons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器触控区域上的坐标和时间；不从普通按键里臆造"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控器觸控區域上的座標和時間；不從普通按鍵裡臆造"
          }
        }
      }
    },
    "privacy.remote-touch.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A touch on the remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
