    "privacy.key-position.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the feature is on and the screen is unlocked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对应功能开着、没有锁屏时"
          }
        }
      }
    },
    "privacy.key-position.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key and click positions together show when you're busy; what you type stays out of reach."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键和点击的位置合起来，能看出你什么时候在忙；打字的内容看不出来。"
          }
        }
      }
    },
    "privacy.key-position.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; no key log is kept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用，不存按键记录"
          }
        }
      }
    },
    "privacy.key-position.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which key was pressed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按了哪个键"
          }
        }
      }
    },
    "privacy.key-position.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts, habit keys and gestures"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键、之前常用的习惯键和手势"
          }
        }
      }
    },
    "privacy.key-position.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which key was pressed, whether a modifier was held, and where you click and scroll; what you type is not read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按了哪个键、有没有同时按修饰键，以及点击和滚动的位置；不读你打的字"
          }
        }
      }
    },
    "privacy.key-position.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sees key positions, never what you type"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只看键位，不记打的字"
          }
        }
      }
    },
    "privacy.key-position.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts, habit keys and gestures in Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的快捷键、之前常用和手势开关"
          }
        }
      }
    },
    "privacy.level-hud.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With notch hints on; volume is read on change and brightness within 0.6 seconds of a press; without key events brightness is read every 0.2 seconds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海提示开着时；音量有变化就读，亮度只在按键后 0.6 秒内读；听不到按键时退回每 0.2 秒读一次亮度"
          }
        }
      }
    },
    "privacy.level-hud.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When volume and brightness were changed, with the hours you use the Mac, shows roughly when you're using it; never what you listen to or watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量和亮度什么时候被调过，合上你的使用时段，能看出你大概什么时候在用这台 Mac；看不出你在听什么、看什么。"
          }
        }
      }
    },
    "privacy.level-hud.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory; never sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存；不发送"
          }
        }
      }
    },
    "privacy.level-hud.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume and brightness"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量和亮度"
          }
        }
      }
    },
    "privacy.level-hud.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows only on a real key press; value changes without one stay off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真的按了音量、亮度键，才在刘海显示；没人按键时数值变了也不显示"
          }
        }
      }
    },
    "privacy.level-hud.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current output volume and mute, the brightness of the display under the pointer, and whether the volume or brightness keys were pressed (only these media keys)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前输出音量和静音、指针所在屏幕的亮度，以及音量、亮度键有没有被按下（只看这几个媒体键）"
          }
        }
      }
    },
    "privacy.level-hud.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when you press volume or brightness keys"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按音量、亮度键时显示"
          }
        }
      }
    },
    "privacy.level-hud.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the notch features; turning off Volume and brightness in Settings stops it too"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟着刘海功能走；设置里的“音量和亮度”关掉后也不再显示"
          }
        }
      }
    },
    "privacy.level-keys.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only with Accessibility granted and this macOS version verified; read and written on those key presses, never polled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在允许了辅助功能、且这个 macOS 版本核对过时；按了这几个键才读才写，平时不轮询"
          }
        }
      }
    },
    "privacy.level-keys.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When these keys were pressed and how far you turned volume and brightness up, with the hours you use the Mac, show when you're using it and whether you're watching or listening; never what you watch or hear, and never what you type."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这几个键什么时候被按过、音量和亮度调成多少，合上你的使用时段，能看出你什么时候在用这台 Mac、是不是在看片或听东西；看不出你在听什么、看什么，也收不到你打的字。"
          }
        }
      }
    },
    "privacy.level-keys.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; not sent, not logged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里；不发送，不写运行记录"
          }
        }
      }
    },
    "privacy.level-keys.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume and brightness keys"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量和亮度键"
          }
        }
      }
    },
    "privacy.level-keys.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catches these keys and shows them at the notch instead; the change is written back at the system's own step and read back to check, and handed back if it doesn't match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拦下这几个键，由刘海显示，系统自己的提示藏起来；拦下的那一下照系统的步长写回系统输出音量与静音、内建屏亮度、键盘灯亮度，写完读回核对，不对就把这一下原样交还系统"
          }
        }
      }
    },
    "privacy.level-keys.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presses and releases of the system keys volume +/−, mute, brightness +/− and keyboard backlight +/−; only this class of system key is subscribed to, so typing keys never arrive. On a press it reads whether the default output can be adjusted, its transport (built-in, Bluetooth, HDMI and so on) and model name (only to recognize AirPods and headphones and swap the symbol on the left), the current volume and mute, the built-in display's brightness, the keyboard backlight level, and the system's Play feedback when changing volume"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量 +/−、静音、亮度 +/−、键盘灯 +/− 这几个系统按键的按下和松开；只订阅系统按键这一类，打字的键收不到。按下时读默认输出设备能不能调、它的传输方式（内建、蓝牙、HDMI 等）和型号名（只为认出 AirPods 和耳机、换左边的符号）、当前音量和静音、内建屏亮度、键盘灯亮度，以及系统“调音量时播放反馈”"
          }
        }
      }
    },
    "privacy.level-keys.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when you press volume or brightness keys"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按音量、亮度键时显示"
          }
        }
      }
    },
    "privacy.level-keys.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume and brightness in Settings (on by default); without Accessibility or a verified version it only listens"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的“音量和亮度”（默认开）；没允许辅助功能或版本没核对过就只旁听"
          }
        }
      }
    },
    "privacy.lock-now-private.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only with Lock when you leave on and your phone recognized"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在打开“离开就锁”，并且认得出你的手机之后"
          }
        }
      }
    },
    "privacy.lock-now-private.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither alone nor together do these say who you are or what you're doing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独和合起来都看不出你是谁、在做什么"
          }
        }
      }
    },
    "privacy.lock-now-private.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never sent, never recorded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不发送，不记录"
          }
        }
      }
    },
    "privacy.lock-now-private.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locking the screen right away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即锁屏"
          }
        }
      }
    },
    "privacy.lock-now-private.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock when you leave: locks this Mac after the countdown once the phone walks away; never unlocks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开就锁：手机走远、倒数完后锁上这台 Mac；从不解锁"
          }
        }
      }
    },
    "privacy.lock-now-private.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads nothing and only asks the system to lock at once; whether it locked is taken from the system's lock state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不读任何东西，只让系统立刻锁屏；锁没锁上，以系统的锁屏状态为准"
          }
        }
      }
    },
    "privacy.lock-now-private.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks as soon as you walk away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走远后立刻锁屏"
          }
        }
      }
    },
    "privacy.lock-now-private.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock when you leave (off by default)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开就锁（默认关）"
          }
        }
      }
    },
    "privacy.lock-state.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated on locking and unlocking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏、解锁时更新"
          }
        }
      }
    },
    "privacy.lock-state.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock state with Lock when you leave shows roughly when you're at your desk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏状态和离开就锁的设置合起来，能看出你大概什么时候在桌前。"
          }
        }
      }
    },
    "privacy.lock-state.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        }
      }
    },
    "privacy.lock-state.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the screen is locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否锁屏"
          }
        }
      }
    },
    "privacy.lock-state.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does nothing while locked; picks up after unlocking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏期间什么都不做，解锁后再接上"
          }
        }
      }
    },
    "privacy.lock-state.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the screen is locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁了还是没锁"
          }
        }
      }
    },
    "privacy.lock-state.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notch drawing and no window moves while locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏时不画刘海、不动窗口"
          }
        }
      }
    },
    "privacy.lock-state.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For safety this can't be turned off on its own"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了安全，不能单独关掉"
          }
        }
      }
    },
    "privacy.login-item.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read once when Settings opens, submitted when you change it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置时读一次，你改的时候提交"
          }
        }
      }
    },
    "privacy.login-item.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login, with the run logs, shows roughly what time you start using this Mac each day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动合上运行记录，能看出你每天大概几点开始用这台 Mac。"
          }
        }
      }
    },
    "privacy.login-item.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed to the system's login item"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交给系统的登录项"
          }
        }
      }
    },
    "privacy.login-item.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动"
          }
        }
      }
    },
    "privacy.login-item.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens after you log in, as you chose"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的选择，登录后自动打开"
          }
        }
      }
    },
    "privacy.login-item.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether WindowShade is set to open at login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WindowShade 有没有设成登录时启动"
          }
        }
      }
    },
    "privacy.login-item.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens automatically after you log in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后自动打开"
          }
        }
      }
    },
    "privacy.login-item.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动"
          }
        }
      }
    },
    "privacy.music-levels.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listens while the notch shows the song, or the card is open, and something is playing; stops after 3 seconds paused, when tucked, locked or full screen; not while the output is Bluetooth headphones or the source is Spotify"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海露着正在放的歌、或大卡开着，而且在放时才听；暂停 3 秒、收回、锁屏、全屏就停；输出是蓝牙耳机、来源是 Spotify 时不听"
          }
        }
      }
    },
    "privacy.music-levels.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loudness with the song playing shows when you're listening."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音大小合上正在放的歌，能看出你什么时候在听。"
          }
        }
      }
    },
    "privacy.music-levels.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; drawn 30 times a second from 5 numbers; nothing stored, sent or logged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里，每秒换成 30 次 5 个数画出来；不存，不发送，不写进运行记录"
          }
        }
      }
    },
    "privacy.music-levels.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How loud playback is"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放的声音大小"
          }
        }
      }
    },
    "privacy.music-levels.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises and falls with the song on the notch's right"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让刘海右边的小点随正在放的歌起伏"
          }
        }
      }
    },
    "privacy.music-levels.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How loud the app that's playing is, in five steps from quiet to loud; only that app is listened to and the sound itself isn't kept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在放歌的那个 App 的声音有多大，分成高低 5 段；只听它一个，声音本身不留下"
          }
        }
      }
    },
    "privacy.music-levels.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dot on the notch's right rises and falls with the song"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海右边的小点随歌起伏"
          }
        }
      }
    },
    "privacy.music-levels.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounce with the sound in Settings, off by default; turning it on is when the system asks about System Audio Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的“跟着声音跳”，默认关；打开时系统才问你“系统音频录制”"
          }
        }
      }
    },
    "privacy.music.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read whenever a playback-change notice arrives, with a timer as a backstop if one is missed; Lock when you leave checks once before locking and once after unlocking; only a broken push stream falls back to asking Music and Spotify, which is when Automation may be requested"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放变化的通知一来就读；通知漏掉时有一个定时兜底；离开就锁锁屏前、解开后各看一次在不在放；只有推送流坏了才退回问音乐和 Spotify，那时才可能请你允许“自动化”"
          }
        }
      }
    },
    "privacy.music.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The song playing, with the hours you use the Mac, shows your taste in music and your daily rhythm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的歌合上你的使用时段，能看出你的音乐口味和作息。"
          }
        }
      }
    },
    "privacy.music.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; song titles stay out of the logs, one cover is kept in memory"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用，歌名不写进运行记录；封面只在内存里留最新一张，不落盘"
          }
        }
      }
    },
    "privacy.music.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The song playing now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的歌"
          }
        }
      }
    },
    "privacy.music.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Song and progress in the notch and Launchpad, with pause and skip"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海和启动台里显示歌名、进度，能暂停和切歌"
          }
        }
      }
    },
    "privacy.music.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title, artist and progress of the song playing, and whether it's playing or paused; one cover is fetched when the song changes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播的歌名、歌手、进度，以及是在播放还是暂停；换歌时取一次封面"
          }
        }
      }
    },
    "privacy.music.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music and Spotify"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐和 Spotify"
          }
        }
      }
    },
    "privacy.music.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now Playing (on by default) and Live activities in Settings; falling back to Music and Spotify also needs Automation in System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的“正在播放”（默认开）和“实时活动”；退回问音乐和 Spotify 时，还要系统设置里的“自动化”"
          }
        }
      }
    },
    "privacy.notch-private.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read once on a display change and noted down"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕变化时读一次，记下来"
          }
        }
      }
    },
    "privacy.notch-private.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither alone nor together do these say who you are or what you're doing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独和合起来都看不出你是谁、在做什么"
          }
        }
      }
    },
    "privacy.notch-private.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        }
      }
    },
    "privacy.notch-private.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact outline of the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海的精确轮廓"
          }
        }
      }
    },
    "privacy.notch-private.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugs the body's edges"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让界面贴合机身的边缘"
          }
        }
      }
    },
    "privacy.notch-private.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notch's outline and corner radius"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海的轮廓和圆角"
          }
        }
      }
    },
    "privacy.notch-private.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps things in the notch inside the rounded corners"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让刘海里的东西贴着圆角"
          }
        }
      }
    },
    "privacy.notch-private.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switch of its own; a plain rectangle stands in when it can't be read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有单独的开关；读不到时退回矩形，看起来略生硬"
          }
        }
      }
    },
    "privacy.now-playing-stream.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates are pushed on change, never polled; no first line within 10 seconds, or three exits within 60, counts as broken and falls back to Music and Spotify; Lock when you leave asks once before locking and once after unlocking; commands go out only when you scrub or press previous, next, play or pause"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统有变化时推过来，不定时去问；10 秒内没有第一行、或 60 秒内退出 3 次就当它坏了，退回问音乐和 Spotify；离开就锁锁屏前、解开后各问一次在不在放；只有你拖进度条、点上一首下一首播放暂停时才发命令"
          }
        }
      }
    },
    "privacy.now-playing-stream.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What any player is playing, with the hours you use the Mac, shows what you listen to and watch, and your daily rhythm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有播放器正在放的内容合上你的使用时段，能看出你在听什么、看什么视频，以及作息。"
          }
        }
      }
    },
    "privacy.now-playing-stream.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads system playback info with a small bundled script; in memory; titles stay out of the logs; never sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 WindowShade 自带的一小段脚本读系统的播放信息；只在内存里；歌名不写进运行记录；不发送"
          }
        }
      }
    },
    "privacy.now-playing-stream.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The song any player is playing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何播放器正在放的歌"
          }
        }
      }
    },
    "privacy.now-playing-stream.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not only Music and Spotify — browsers and other players show and control too"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不只 Music 和 Spotify，网页和别的播放器也能显示和控制"
          }
        }
      }
    },
    "privacy.now-playing-stream.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app playing, track, artist, progress and play state; one cover is fetched when the song changes; when you let go of the scrubber on the card, one seek is sent to the app that's playing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的 App、曲目、艺人、进度、播放状态；换歌时单独取一次封面；你在大卡上松开进度条时，向正在播的 App 发一次跳转"
          }
        }
      }
    },
    "privacy.now-playing-stream.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works for browsers and other players too"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页和别的播放器也能显示"
          }
        }
      }
    },
    "privacy.now-playing-stream.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default until you change it; turning off Now Playing or Live activities in Settings stops it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认开（没设置过就是开）；设置里的“正在播放”或实时活动关掉就停"
          }
        }
      }
    },
    "privacy.pair-verify-identity.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the keychain only while Remote mode is on; a new pairing needs Touch ID at the notch first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式打开时才从钥匙串读；新配对要先在刘海里用 Touch ID 确认"
          }
        }
      }
    },
    "privacy.pair-verify-identity.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other side's public keys together reveal which devices you've paired."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对端的公钥合起来，能认出你配对过哪台设备。"
          }
        }
      }
    },
    "privacy.pair-verify-identity.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public keys and device names go into this Mac's keychain; session keys stay in memory"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公钥和设备名存在这台 Mac 的钥匙串里；会话密钥只在内存中"
          }
        }
      }
    },
    "privacy.pair-verify-identity.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity of the paired device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对后的对端身份"
          }
        }
      }
    },
    "privacy.pair-verify-identity.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this device can step into Conductor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有这台设备能进入指挥模式"
          }
        }
      }
    },
    "privacy.pair-verify-identity.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The paired iPhone's public key, version and self-reported device name, and this connection's session key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对 iPhone 的公钥、版本号和它报的设备名，以及这次连接的会话密钥"
          }
        }
      }
    },
    "privacy.pair-verify-identity.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only paired devices get in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只让配对过的设备进入"
          }
        }
      }
    },
    "privacy.pair-verify-identity.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode; Remove in Settings undoes this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式；设置里的「移除」撤销这一台"
          }
        }
      }
    },
    "privacy.presence-bluetooth.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Lock when you leave on and a device picked, the connection is read every few seconds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开就锁打开且选了随身设备后，每隔几秒读一次连接状态"
          }
        }
      }
    },
    "privacy.presence-bluetooth.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pocket device connecting and disconnecting shows when you take it away from this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随身设备的连接与断开合起来，能看出你什么时候带着它离开这台 Mac。"
          }
        }
      }
    },
    "privacy.presence-bluetooth.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; nothing uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用；不上传"
          }
        }
      }
    },
    "privacy.presence-bluetooth.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether your Bluetooth device is nearby"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随身蓝牙设备的在不在"
          }
        }
      }
    },
    "privacy.presence-bluetooth.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks when the device walks away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备走远了就锁屏"
          }
        }
      }
    },
    "privacy.presence-bluetooth.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the paired Bluetooth device you picked is connected, and its signal strength while connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选的那台已配对蓝牙设备连没连着，以及连着时的信号强度"
          }
        }
      }
    },
    "privacy.presence-bluetooth.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks when the device walks away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备走远就锁屏"
          }
        }
      }
    },
    "privacy.presence-bluetooth.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lock when you leave switch; clearing the device choice stops it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开就锁的开关；清空随身设备的选择即停"
          }
        }
      }
    },
    "privacy.private-app-list.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the private app list opens or an entry is added or removed, and when a feature that uses the list runs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“私人 App”、添加或移除时；用到名单的功能触发时读"
          }
        }
      }
    },
    "privacy.private-app-list.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private app list with your habits shows which chats and mail you care about protecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私人 App 名单和你的使用习惯合起来，能看出你在意保护哪些聊天和邮件。"
          }
        }
      }
    },
    "privacy.private-app-list.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this Mac's settings; it never leaves"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在这台 Mac 的设置里，不离开本机"
          }
        }
      }
    },
    "privacy.private-app-list.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private app list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私人 App 名单"
          }
        }
      }
    },
    "privacy.private-app-list.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watching, Lock when you leave and Focus act only on the listed apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人在看、离开就锁、专注时，只处理名单里的 App"
          }
        }
      }
    },
    "privacy.private-app-list.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private apps you pick in Settings (only their identifiers are kept)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在设置里选的私人 App（只存它们的标识）"
          }
        }
      }
    },
    "privacy.private-app-list.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which apps count as private"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些 App 算私人"
          }
        }
      }
    },
    "privacy.private-app-list.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private app list in Settings; entries can be removed at any time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的“私人 App”，随时可以移除"
          }
        }
      }
    },
    "privacy.private-contact.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not read at present"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前不读"
          }
        }
      }
    },
    "privacy.private-contact.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact positions and area together show your gesture habits and the size of your hand."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触点的位置和面积合起来，能看出你的手势习惯和手的大小。"
          }
        }
      }
    },
    "privacy.private-contact.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; only the current touch, no long-term gesture paths"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里，只留当前这一次接触；不录长期的手势轨迹"
          }
        }
      }
    },
    "privacy.private-contact.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad and mouse contacts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控板和鼠标触点"
          }
        }
      }
    },
    "privacy.private-contact.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to tell taps from drags"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给轻点和拖动的判断用"
          }
        }
      }
    },
    "privacy.private-contact.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device, contact ids, positions and areas, and frame times"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备、触点编号、位置和面积、帧时间"
          }
        }
      }
    },
    "privacy.private-contact.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For taps and drags"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给轻点和拖动用"
          }
        }
      }
    },
    "privacy.private-contact.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input enhancement; unrecognized devices skip this path"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入增强；认不出的设备不走这条路"
          }
        }
      }
    },
    "privacy.recording-app.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While live activities are on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动开着时"
          }
        }
      }
    },
    "privacy.recording-app.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which app is recording, with the window you're using, shows whether you're in a meeting or a call."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪个 App 在录音，加上你正在用的窗口，能看出你是不是在开会或通话。"
          }
        }
      }
    },
    "privacy.recording-app.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        }
      }
    },
    "privacy.recording-app.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which app is recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪个 App 在录音"
          }
        }
      }
    },
    "privacy.recording-app.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows recording in live activities"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在实时活动里显示正在录音"
          }
        }
      }
    },
    "privacy.recording-app.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which app is recording; the recording's content is not read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪个 App 正在录音；不读录音的内容"
          }
        }
      }
    },
    "privacy.recording-app.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notch says a word while recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音时刘海提一句"
          }
        }
      }
    },
    "privacy.recording-app.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live activities"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动"
          }
        }
      }
    },
    "privacy.recovery.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a window rolls up or is put back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起、放回窗口时"
          }
        }
      }
    },
    "privacy.recovery.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles and positions in the recovery records together show which windows you rolled up last time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复记录里的窗口标题和位置合起来，能看出你上次收起了哪些窗口。"
          }
        }
      }
    },
    "privacy.recovery.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this Mac's recovery records"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在这台 Mac 上的恢复记录里"
          }
        }
      }
    },
    "privacy.recovery.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery records"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复记录"
          }
        }
      }
    },
    "privacy.recovery.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts your windows back if the app runs into trouble"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序出问题后，把你的窗口放回原处"
          }
        }
      }
    },
    "privacy.recovery.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles and positions of rolled-up windows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起的窗口的标题和位置"
          }
        }
      }
    },
    "privacy.recovery.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings windows back if something goes wrong"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出问题时找回窗口"
          }
        }
      }
    },
    "privacy.recovery.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switch of its own; WindowShade doesn't delete other apps' data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有单独的开关；WindowShade 不会删别的 App 的数据"
          }
        }
      }
    },
    "privacy.remote-advertise.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Announces while Remote mode is on, stopping when it's off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式打开时宣告，关掉就停"
          }
        }
      }
    },
    "privacy.remote-advertise.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The announced name with remote connections shows anyone on the same network that this Mac has Remote mode on and roughly when it's in use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宣告的名字和遥控连接合起来，同一个网络里的人能看出这台 Mac 开着遥控模式、大概什么时候在用。"
          }
        }
      }
    },
    "privacy.remote-advertise.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this local network only; nothing uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在这个局域网里；不上传"
          }
        }
      }
    },
    "privacy.remote-advertise.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac as it appears on the local network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在局域网里出现的这台 Mac"
          }
        }
      }
    },
    "privacy.remote-advertise.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the iPhone remote find this Mac in its list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 iPhone 上的遥控器在列表里找到这台 Mac"
          }
        }
      }
    },
    "privacy.remote-advertise.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads nothing; announces this Mac's name to devices on the same local network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不读东西；把这台 Mac 的名字宣告给同一个局域网里的设备"
          }
        }
      }
    },
    "privacy.remote-advertise.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone can find this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 能找到这台 Mac"
          }
        }
      }
    },
    "privacy.remote-advertise.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式"
          }
        }
      }
    },
    "privacy.remote-hid.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Remote mode on and a source bound; a disconnect cancels every key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式开着并绑定了来源；断线就取消所有按键"
          }
        }
      }
    },
    "privacy.remote-hid.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote buttons show when you use the remote and which keys you reach for."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器的按钮合起来，能看出你什么时候在用遥控器、常按哪些键。"
          }
        }
      }
    },
    "privacy.remote-hid.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; the mapping's ownership record stays on this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里；映射的归属记录只存在这台 Mac 上"
          }
        }
      }
    },
    "privacy.remote-hid.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote buttons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器按钮"
          }
        }
      }
    },
    "privacy.remote-hid.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps to actions in Remote mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在遥控模式里对应到动作"
          }
        }
      }
    },
    "privacy.remote-hid.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each remote button's press and release, and the connection state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器每个按键的按下和松开，以及连接状态"
          }
        }
      }
    },
    "privacy.remote-hid.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons in Remote mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式里的按键"
          }
        }
      }
    },
    "privacy.remote-hid.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode; only the mappings it took are restored on quit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式；退出时只还原自己占用的映射"
          }
        }
      }
    },
    "privacy.remote-lan.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Announces and accepts connections only after Remote mode is on; off by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式打开之后才宣告、接受连接；默认关"
          }
        }
      }
    },
    "privacy.remote-lan.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote connections show when you're driving this Mac from an iPhone on the same network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控连接合起来，能看出你什么时候在用 iPhone 遥控这台 Mac、在同一个网络里。"
          }
        }
      }
    },
    "privacy.remote-lan.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this local network only; nothing uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在这个局域网里；不上传"
          }
        }
      }
    },
    "privacy.remote-lan.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone remote's local connection to this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上的遥控器的本地连接"
          }
        }
      }
    },
    "privacy.remote-lan.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets an iPhone work as a remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 iPhone 当遥控器用"
          }
        }
      }
    },
    "privacy.remote-lan.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection state, key and touch commands from the remote app on an iPhone on the same local network; other devices aren't read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个局域网里 iPhone 上的遥控器发来的连接状态和按键、触摸指令；不读别的设备"
          }
        }
      }
    },
    "privacy.remote-lan.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone as a remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 当遥控器"
          }
        }
      }
    },
    "privacy.remote-lan.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode; turning it off stops announcing, disconnects and stops listening"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式；关掉就停止宣告、断开并停止监听"
          }
        }
      }
    },
    "privacy.remote-touch.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the coordinate source is confirmed; without coordinates only buttons are used"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认过坐标来源之后；没有坐标就只用按钮"
          }
        }
      }
    },
    "privacy.remote-touch.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch paths show how you use the remote, including the gestures you reach for."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触摸轨迹合起来，能看出你怎么用遥控器，包括惯用的手势。"
          }
        }
      }
    },
    "privacy.remote-touch.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the current stroke, at most 2048 points"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只留当前这一笔，最多 2048 个点"
          }
        }
      }
    },
    "privacy.remote-touch.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote's touch area"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器触控区域"
          }
        }
      }
    },
    "privacy.remote-touch.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path input in Conductor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥模式里的轨迹输入"
          }
        }
      }
    },
    "privacy.remote-touch.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordinates and times on the remote's touch area; nothing is invented from ordinary buttons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器触控区域上的坐标和时间；不从普通按键里臆造"
          }
        }
      }
    },
    "privacy.remote-touch.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A touch on the remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器上的一笔"
          }
        }
      }
    },
    "privacy.remote-touch.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥模式"
          }
        }
      }
    },
    "privacy.remote-volume.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Remote mode on, an iPhone connected and a volume key pressed; nothing is read or written without a press"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式开着、iPhone 已连上、按了音量键时；不按键就不读不写"
          }
        }
      }
    },
    "privacy.remote-volume.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often you changed volume from the remote, with the times it was connected, shows when you use it; never what you listen to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器调过几次音量，合上连接的时段，能看出你什么时候在用遥控器；看不出你在听什么。"
          }
        }
      }
    },
    "privacy.remote-volume.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; never sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里；不发送"
          }
        }
      }
    },
    "privacy.remote-volume.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume changes from the remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用遥控器调音量"
          }
        }
      }
    },
    "privacy.remote-volume.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes this Mac's volume from the iPhone remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 iPhone 上的遥控器调这台 Mac 的音量"
          }
        }
      }
    },
    "privacy.remote-volume.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current output volume; a volume key adds or removes one step and writes it back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前输出音量；按音量键时在原来的基础上加减一格并写回"
          }
        }
      }
    },
    "privacy.remote-volume.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote's volume buttons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控器的音量键"
          }
        }
      }
    },
    "privacy.remote-volume.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode; turning it off stops the changes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式；关掉就不再调"
          }
        }
      }
    },
    "privacy.screen-shape.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read when needed, and once when the Privacy page opens"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用到的时候读；打开隐私这一页时读一次"
          }
        }
      }
    },
    "privacy.screen-shape.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number of displays and the notch shape together show which kind of Mac you use and whether a monitor is attached."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕数量和刘海形状合起来，能看出你用的是哪一类 Mac，有没有接外接显示器。"
          }
        }
      }
    },
    "privacy.screen-shape.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        }
      }
    },
    "privacy.screen-shape.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shape of the display and the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕和刘海的形状"
          }
        }
      }
    },
    "privacy.screen-shape.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts controls on the right display, next to the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把控件放在对的那块屏、刘海旁边"
          }
        }
      }
    },
    "privacy.screen-shape.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many displays there are, their sizes, and whether there's a notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕有几块、多大，有没有刘海"
          }
        }
      }
    },
    "privacy.screen-shape.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugs the body when tucked into the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收进刘海时贴着机身"
          }
        }
      }
    },
    "privacy.screen-shape.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switch of its own; it follows the notch features"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有单独的开关，跟着刘海功能走"
          }
        }
      }
    },
    "privacy.settings.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read when the feature needs it; the Privacy page only shows values already read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功能需要时读；隐私这一页只读已有的值"
          }
        }
      }
    },
    "privacy.settings.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings together show how you work and which features you've turned on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设置合起来，能看出你的使用习惯和开过哪些功能。"
          }
        }
      }
    },
    "privacy.settings.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this Mac; one-time approval tickets aren't kept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在这台 Mac 上；不存一次性的批准票据"
          }
        }
      }
    },
    "privacy.settings.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "privacy.settings.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembers your choice and follows the system setting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住你的选择，也跟着系统设置走"
          }
        }
      }
    },
    "privacy.settings.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The choices you make in Settings (including the countdown minutes you last picked and each app's last column widths in the scroll strip) and a few system settings (including whether the system is muted)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在设置里做的选择（含上次选的计时分钟数、卷轴里每个 App 上次用的列宽），和用到的几项系统设置（含系统是否静音）"
          }
        }
      }
    },
    "privacy.settings.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembers your choice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住你的选择"
          }
        }
      }
    },
    "privacy.settings.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switches in Settings; Reset clears only WindowShade's own values"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的各项开关；“重置”只清 WindowShade 自己的值"
          }
        }
      }
    },
    "privacy.spaces-private.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you look at other desktops in the notch row or the window browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在刘海那一排或窗口浏览里看别的桌面时"
          }
        }
      }
    },
    "privacy.spaces-private.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows on other desktops and their pictures together show what else you have open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他桌面的窗口和画面合起来，能看出你在别的桌面上还开着什么。"
          }
        }
      }
    },
    "privacy.spaces-private.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for previews, never sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来显示预览，不发送"
          }
        }
      }
    },
    "privacy.spaces-private.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictures of windows on other desktops and minimized"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他桌面和最小化窗口的画面"
          }
        }
      }
    },
    "privacy.spaces-private.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public APIs can't capture windows on other desktops or minimized ones; app icons stand in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开接口拿不到别的桌面和已最小化窗口的画面；读不到时显示应用图标"
          }
        }
      }
    },
    "privacy.spaces-private.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which windows are on other desktops, where they sit and their pictures; it also reads whether this display is a full-screen desktop (the notch steps aside while full screen or Mission Control is open)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别的桌面上有哪些窗口、窗口在哪，以及它们的画面；也读你这块屏现在是不是全屏桌面（全屏或调度中心开着时刘海让开）"
          }
        }
      }
    },
    "privacy.spaces-private.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every window shows up in the notch row"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海那一排能看到每一扇"
          }
        }
      }
    },
    "privacy.spaces-private.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off Screen Recording in System Settings and only icons show"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置里关掉“屏幕录制”，就只显示图标"
          }
        }
      }
    },
    "privacy.speech-input.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you hold and speak, up to 60 seconds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你按住说话时，最长 60 秒"
          }
        }
      }
    },
    "privacy.speech-input.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech and its transcription together show what you say and when."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音和转写的文字合起来，能看出你在说什么、什么时候在说。"
          }
        }
      }
    },
    "privacy.speech-input.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognized on this Mac by default; if it can't, that's switched off and you're told; the cloud needs separate consent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认在这台 Mac 上识别；这台 Mac 不能识别就停用并告诉你，用云端要另外征得你同意"
          }
        }
      }
    },
    "privacy.speech-input.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入"
          }
        }
      }
    },
    "privacy.speech-input.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes a draft; press play again to submit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成草稿，你再按一次播放才提交"
          }
        }
      }
    },
    "privacy.speech-input.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound from the microphone you picked, and a temporary transcription"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选的麦克风的声音、临时转写的文字"
          }
        }
      }
    },
    "privacy.speech-input.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say a sentence, get a draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说一句，得到草稿"
          }
        }
      }
    },
    "privacy.speech-input.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks the microphone; letting go or cancelling stops it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择麦克风；松手或取消就停"
          }
        }
      }
    },
    "privacy.system-quiet.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At launch, and once each time you switch apps, an app launches or quits, the screen locks or unlocks, or you change desktops; no timers. Focus is read only after you turn the switch on here and agree in the system prompt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时，以及切换 App、App 启动或退出、锁屏或解锁、换桌面时各读一次，不会定时去读；专注模式要你在这里打开开关、再在系统弹窗里同意后才读"
          }
        }
      }
    },
    "privacy.system-quiet.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the screen is shared with whether Focus is on shows you're probably in a meeting or presenting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否在共享屏幕和是否开着专注模式合起来，能看出你大概正在开会或演示。"
          }
        }
      }
    },
    "privacy.system-quiet.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; not recorded, not sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用，不记录，不发送"
          }
        }
      }
    },
    "privacy.system-quiet.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the screen is shared and Focus is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕是否在被共享、专注模式是否开着"
          }
        }
      }
    },
    "privacy.system-quiet.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While sharing, private apps show only an icon in the notch row and stuck hints stay silent; in Focus a brief notice leaves just a dot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享屏幕时，私人 App 在刘海那一排里只显示图标，卡住提示不出声；专注模式开着时，短暂提醒只留一个小点"
          }
        }
      }
    },
    "privacy.system-quiet.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the screen is being shared or recorded and whether Focus is on; only yes or no is read, never who it's shared with or the name of the Focus"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕有没有正在被共享或录制，系统专注模式开没开；只读“有”或“没有”，不读共享给了谁、专注模式的名字"
          }
        }
      }
    },
    "privacy.system-quiet.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notch keeps quieter while sharing or in Focus"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享或专注时刘海更安静"
          }
        }
      }
    },
    "privacy.system-quiet.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus: expand this row, turn on Quieter in Focus and agree in the system prompt; off by default. Sharing has no switch of its own — it only quiets the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注模式：展开这一行，打开「专注模式时更安静」并在系统弹窗里同意才读，默认关；共享状态没有单独的开关，它只会让刘海更安静"
          }
        }
      }
    },
    "privacy.tilt.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read while Desktop lid is on, stopping when it's off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面开合开着时读，关掉就停"
          }
        }
      }
    },
    "privacy.tilt.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body tilt with the lid angle shows whether this Mac is on a desk, a lap or in your hands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机身倾斜加上屏幕开合，能看出这台 Mac 是在桌上，还是在腿上或手里。"
          }
        }
      }
    },
    "privacy.tilt.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        }
      }
    },
    "privacy.tilt.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the body is tilted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机身的倾斜"
          }
        }
      }
    },
    "privacy.tilt.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves the lid effect's light with the body's angle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让开合时的光影跟着机身角度变"
          }
        }
      }
    },
    "privacy.tilt.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which way the body tilts and whether it's moving"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机身往哪边倾斜、有没有在动"
          }
        }
      }
    },
    "privacy.tilt.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The light and shadow in the lid effect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开合效果里的光影"
          }
        }
      }
    },
    "privacy.tilt.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop lid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面开合"
          }
        }
      }
    },
    "privacy.unlock-secret.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not read at present; it will be enabled separately once there's somewhere to keep it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前不读；有可用的存放方式之后，另行启用"
          }
        }
      }
    },
    "privacy.unlock-secret.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock credentials in someone else's hands, with the lock state, would open this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁凭据若落到别人手里，合上锁屏状态就能进入这台 Mac。"
          }
        }
      }
    },
    "privacy.unlock-secret.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept where the system protects it, such as the keychain; never in logs or the assistant's context"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只放在钥匙串这类系统保护的地方；不进运行记录、不进助手的上下文"
          }
        }
      }
    },
    "privacy.unlock-secret.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock credentials"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁凭据"
          }
        }
      }
    },
    "privacy.unlock-secret.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for returning to the desktop after unlocking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用在锁屏之后回到桌面这一步"
          }
        }
      }
    },
    "privacy.unlock-secret.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads only the credentials you explicitly created and the system protects"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读你明确建立的、受系统保护的凭据"
          }
        }
      }
    },
    "privacy.unlock-secret.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns to the desktop after unlocking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏后回到桌面"
          }
        }
      }
    },
    "privacy.unlock-secret.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the record; without somewhere to keep it, support isn't offered"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除登记；没有可用的存放方式就不显示支持"
          }
        }
      }
    },
    "privacy.update.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the chosen frequency while Check for updates automatically is on, or when you click Check for Updates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动检查更新”开着时按频率检查，或你点“检查更新”时"
          }
        }
      }
    },
    "privacy.update.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update server sees which version you run and which network you come from, which together show how long it's been since you updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新服务看得到你用哪个版本、从哪个网络来，合起来能看出你多久没更新。"
          }
        }
      }
    },
    "privacy.update.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update server (the website; GitHub if it's unreachable)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新服务器（官网；那里不通时改问 GitHub）"
          }
        }
      }
    },
    "privacy.update.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update checks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新"
          }
        }
      }
    },
    "privacy.update.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches the new-version list and the download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取得新版本的清单和下载"
          }
        }
      }
    },
    "privacy.update.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WindowShade's version, plus the network information the update server sees anyway"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WindowShade 的版本号，以及更新服务器本来就看得到的网络信息"
          }
        }
      }
    },
    "privacy.update.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks the website whether there's a new version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问官网有没有新版本"
          }
        }
      }
    },
    "privacy.update.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates automatically; manual checks still work when it's off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新；关掉后仍可手动检查"
          }
        }
      }
    },
    "privacy.window-ax.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When rolling up, putting back and arranging"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起、放回、排窗口时"
          }
        }
      }
    },
    "privacy.window-ax.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window titles and positions together show which file you're working on and which page you're reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口的标题和位置合起来，能看出你在处理哪份文件、看哪个网页。"
          }
        }
      }
    },
    "privacy.window-ax.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; rolled-up window titles and positions go into recovery records"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用；收起的窗口的标题和位置记在恢复记录里，出问题时用来找回窗口"
          }
        }
      }
    },
    "privacy.window-ax.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window titles, positions and sizes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口的标题、位置和大小"
          }
        }
      }
    },
    "privacy.window-ax.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolling up, putting back and arranging all need to know where windows are"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起、放回、排窗口，都要先知道窗口在哪"
          }
        }
      }
    },
    "privacy.window-ax.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window titles, positions and sizes, and which app each belongs to"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口的标题、位置和大小，以及它属于哪个 App"
          }
        }
      }
    },
    "privacy.window-ax.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds, moves and restores windows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到、移动和恢复窗口"
          }
        }
      }
    },
    "privacy.window-ax.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off Accessibility and WindowShade can no longer read windows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置里关掉“辅助功能”，WindowShade 就不能再读窗口"
          }
        }
      }
    },
    "privacy.window-image.activation": {
