      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With ⌥ held, one scroll moves a single line. Needs Smooth scrolling or Mouse scroll direction on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 时，一条滚动只走一行。要和平滑滚动或鼠标滚动方向一起开。"
          }
        }
      }
    },
    "settings.input.fine.name": {
