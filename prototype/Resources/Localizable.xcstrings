    },
    "privacy.conductor-ipc.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passed within this Mac; it doesn't listen on the network by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在这台 Mac 里传递；默认不在局域网里监听"
          }
        }
      }
    },
    "privacy.conductor-ipc.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor connections"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥连接"
          }
        }
      }
    },
    "privacy.conductor-ipc.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ties input to the assistant session on this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把输入和这台 Mac 上的助手会话绑在一起"
          }
