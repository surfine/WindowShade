            "value": "你沒動過的開關，現在是開著的。不想要哪樣，在設定裡關掉。"
          }
        }
      }
    },
    "whatsNew1018.notch.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuck windows into the notch. It tells you the Mac shortcut when one doesn’t work, and shows music and downloads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口能收进刘海；按错快捷键时刘海说一句；音乐、下载这些显示在刘海上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗能收進瀏海；按錯快速鍵時瀏海說一句；音樂、下載這些顯示在瀏海上。"
          }
        }
      }
    },
    "whatsNew1018.dock.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest the pointer on a Dock icon to see that app’s windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针停在 Dock 图标上，这个 App 的窗口排出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指標停在 Dock 圖示上，這個 App 的視窗排出來。"
          }
        }
      }
    },
