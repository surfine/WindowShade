    "settings.privacy.network.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks %@ whether there's a new version, sending the current version number; if that's unreachable it asks GitHub (%@) instead. Turning off Check for updates automatically stops it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问 %@ 有没有新版本，带上现在的版本号；那里不通时改问 GitHub（%@）。关掉“自动检查更新”，就不会自己联网检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問 %@ 有沒有新版本，帶上現在的版本號；那裡不通時改問 GitHub（%@）。關掉“自動檢查更新”，就不會自己聯網檢查。"
          }
        }
      }
    },
    "settings.privacy.network.lead": {
      "extractionState": "manual",
      "localizations": {
