    "privacy.download-files.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only after you turn on Browser downloads; read on folder changes, never by polling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你打开“浏览器下载”之后；文件夹有变化时才读，没有轮询"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你開啟“瀏覽器下載”之後；資料夾有變化時才讀，沒有輪詢"
          }
        }
      }
    },
    "privacy.download-files.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filenames of downloads together show what you've been downloading and roughly from where; contents stay invisible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载中的文件名合起来，能看出你最近在下载什么、从哪类网站下；文件内容看不到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載中的檔名合起來，能看出你最近在下載什麼、從哪類網站下；檔案內容看不到。"
          }
        }
      }
    },
    "privacy.download-files.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory only; not sent, not logged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里；不发送，不写运行记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡；不傳送，不寫執行記錄"
          }
        }
      }
    },
    "privacy.download-files.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished downloads in the Downloads folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载文件夹里没下完的文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載資料夾裡沒下完的檔案"
          }
        }
      }
    },
    "privacy.download-files.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how many are downloading and says when one finishes; no file contents, no invented progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示正在下载的个数和下好了的提示；不读文件内容，不编进度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示正在下載的個數和下好了的提示；不讀檔案內容，不編進度"
          }
        }
      }
    },
    "privacy.download-files.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and modification times of unfinished temporary downloads (.crdownload, .download, .part) in the Downloads folder; when one disappears, the size and modification time of the file with the same name, to tell a finished download from a cancelled one"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载文件夹里没下完的临时文件（.crdownload、.download、.part）的名字和修改时间；临时文件消失时，再看一眼同名文件的大小和修改时间，分清下好了还是取消了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載資料夾裡沒下完的臨時檔案（.crdownload、.download、.part）的名字和修改時間；臨時檔案消失時，再看一眼同名檔案的大小和修改時間，分清下載好了還是取消了"
          }
        }
      }
    },
    "privacy.download-files.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows unfinished downloads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示没下完的文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示沒下完的檔案"
          }
        }
      }
    },
    "privacy.download-files.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser downloads in Live activities (off by default)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动里的“浏览器下载”（默认关）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時活動裡的“瀏覽器下載”（預設關）"
          }
        }
      }
    },
    "privacy.drag-kind.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while dragging"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在拖动期间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在拖移期間"
          }
        }
      }
    },
    "privacy.drag-kind.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All that's known is what kind of thing you dragged, never its content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只知道你拖的是哪一类，看不出是什么内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只知道你拖的是哪一類，看不出是什麼內容。"
          }
        }
      }
    },
    "privacy.drag-kind.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in memory only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡用"
          }
        }
      }
    },
    "privacy.drag-kind.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What kind of thing you're dragging"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拖的是哪一类"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拖的是哪一類"
          }
        }
      }
    },
    "privacy.drag-kind.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drops the right landing island as you drag near the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖近刘海时垂下对的落点小岛"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖近瀏海時垂下對的落點小島"
          }
        }
      }
    },
    "privacy.drag-kind.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether you're dragging files, text, images or links, and how many; contents aren't looked at"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拖的是文件、文字、图片还是链接，有几个；不看内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拖的是檔案、文字、圖片還是連結，有幾個；不看內容"
          }
        }
      }
    },
    "privacy.drag-kind.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognizes the kind of thing as you drag it near the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖近刘海时认出是哪一类"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖近瀏海時認出是哪一類"
          }
        }
      }
    },
    "privacy.drag-kind.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the file shelf"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟着文件架走"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟著檔案架走"
          }
        }
      }
    },
    "privacy.face-identity.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default; once the experiment is on it looks up to 6 seconds when the screen lights up while locked, at up to 10 frames a second; with the head-turn challenge it watches up to 12 more seconds after recognizing; at most 3 times per lock, and an unclear picture doesn't count"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭；打开实验后，锁屏时屏幕亮起最多看 6 秒，每秒最多 10 帧；打开转头挑战，认出后再看最多 12 秒；每次锁屏最多 3 次，画面看不清不算次数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉；開啟實驗後，鎖定畫面時螢幕亮起最多看 6 秒，每秒最多 10 幀；開啟轉頭挑戰，認出後再看最多 12 秒；每次鎖定畫面最多 3 次，畫面看不清不算次數"
          }
        }
      }
    },
    "privacy.face-identity.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face features and camera pictures together can tell whether it's you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸特征和摄像头画面合起来，能认出这是不是你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "人臉特徵和網路攝影機畫面合起來，能認出這是不是你。"
          }
        }
      }
    },
    "privacy.face-identity.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates live in this Mac's keychain, not synced and not carried into backups; pictures and crops aren't kept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板只存在这台 Mac 的钥匙串里，不同步、不随备份迁走；画面和裁切图不存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模板只存在這台 Mac 的鑰匙串裡，不同步、不隨備份遷走；畫面和裁切圖不存"
          }
        }
      }
    },
    "privacy.face-identity.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face features and the comparison result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脸部特征与比对结果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "臉部特徵與比對結果"
          }
        }
      }
    },
    "privacy.face-identity.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognizes you after unlocking, keeps one hint, and never unlocks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏后认出是不是你，只留一条证据，不会解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定畫面後認出是不是你，只留一條證據，不會解鎖"
          }
        }
      }
    },
    "privacy.face-identity.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experiment: image features cropped from the face (computed by Apple's Vision), the enrolled template, how open the eyes were at enrolment, the enrolment number and the comparison result; with the head-turn challenge, also which way the face turns and whether the eyes are open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验：脸部裁出来的图像特征（Apple 的 Vision 算出）、登记过的模板、录入时眼睛睁开的程度、录入序号、比对结果；打开转头挑战后，还有转头时脸朝哪边、眼睛睁没睁开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗：臉部裁出來的影像特徵（Apple 的 Vision 算出）、登記過的模板、錄入時眼睛睜開的程度、錄入序號、比對結果；開啟轉頭挑戰後，還有轉頭時臉朝哪邊、眼睛睜沒睜開"
          }
        }
      }
    },
    "privacy.face-identity.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognizes you after unlocking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏后认出是不是你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定畫面後認出是不是你"
          }
        }
      }
    },
    "privacy.face-identity.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The experiment switch and removing the record; never labelled Face ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验开关和删除登记；不会标成 Face ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗開關和刪除登記；不會標成 Face ID"
          }
        }
      }
    },
    "privacy.face-quality.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows face unlock (experimental): it looks only when the screen lights up after locking, up to 6 seconds; screen and phone edges are checked every 3 frames"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟着刷脸解锁（实验）：锁屏后屏幕亮起才看，最多 6 秒；屏幕和手机的边框每 3 帧看一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟著刷臉解鎖（實驗）：鎖定畫面後螢幕亮起才看，最多 6 秒；螢幕和手機的邊框每 3 幀看一次"
          }
        }
      }
    },
    "privacy.face-quality.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How clear the picture is, with face features, shows whether a real person is in front of the camera or a photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面清不清楚和脸部特征合起来，能看出镜头前是真人还是照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面清不清楚和臉部特徵合起來，能看出鏡頭前是真人還是照片。"
          }
        }
      }
    },
    "privacy.face-quality.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decided in memory; no picture kept, nothing uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里判断，不存画面，不上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡判斷，不存畫面，不上傳"
          }
        }
      }
    },
    "privacy.face-quality.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the face picture is clear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脸部画面清不清楚"
          }
        },
        "zh-Hant": {
