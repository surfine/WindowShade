    "owned.ui.consent.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs only after you click Start. Codex keeps its sign-in and session files in WindowShade's own folder and never touches your existing ~/.codex. Read-only doesn't mean offline or limited to the chosen folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在点击启动后运行。登录和会话文件由 Codex 存在 WindowShade 的独立目录中，不修改你原有的 ~/.codex。只读不等于离线或只允许读取所选目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在點選啟動後執行。登入和工作階段檔案由 Codex 存在 WindowShade 的獨立目錄中，不修改你原有的 ~/.codex。唯讀不等於離線或只允許讀取所選目錄。"
          }
        }
      }
    },
    "owned.ui.diagnostic.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps at most 64 KiB of in-memory diagnostics, which may contain paths and sensitive content. Nothing is uploaded or exported automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多保留 64 KiB 内存诊断，可能含路径和敏感内容。不会自动上传或导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多保留 64 KiB 記憶體診斷，可能含路徑和敏感內容。不會自動上傳或匯出。"
          }
        }
      }
    },
