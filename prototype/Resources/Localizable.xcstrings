    "settings.shade.supplement.codingTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a project and Codex locally; after sign-in it queries read-only. Opening the page starts nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地选择项目和 Codex，登录后进行只读查询。打开页面不会启动程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地選擇專案和 Codex，登入後進行唯讀查詢。開啟頁面不會啟動程式。"
          }
        }
      }
