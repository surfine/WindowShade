      }
    },
    "privacy.conductor-ipc.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other side's identity in the same account, project and session ids, and a request summary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一账户里对方的身份、项目和会话编号、请求摘要"
          }
        }
      }
    },
    "privacy.conductor-ipc.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ties the input to the assistant session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定输入和助手会话"
          }
        }
      }
    },
    "privacy.conductor-ipc.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor ties to a project"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥模式和项目绑定"
          }
        }
      }
    },
    "privacy.conductor-touch.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Conductor on and the remote connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
