    "launchpad.uninstallDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app and its related files in ~/Library go to the Trash together, and you can get them back from there. You can also just remove it from the Home Screen and leave the app itself alone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 和它在 ~/Library 的关联文件会一起移到废纸篓，可从废纸篓找回。也可以只把它从主屏幕移除，App 本体不动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 和它在 ~/Library 的關聯檔案會一起移到垃圾桶，可從垃圾桶找回。也可以只把它從主螢幕移除，App 本體不動。"
          }
        }
      }
    },
