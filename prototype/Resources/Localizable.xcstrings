    "settings.remote.mode.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once on, this Mac appears in the remote app on the iPhone. Turn it off and it disappears; connected phones disconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后，这台 Mac 出现在 iPhone 上的遥控器的列表里。关掉就不再出现，连着的也会断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，這台 Mac 出現在 iPhone 上的遙控器的列表裡。關掉就不再出現，連著的也會中斷連線。"
          }
