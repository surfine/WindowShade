      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flick a title bar toward the notch to tuck the window; rest on the notch and click to bring it back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朝刘海甩一下标题栏，窗口就收进刘海；指针停在刘海上，点一下放回"
          }
        }
      }
    },
