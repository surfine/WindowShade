          "stringUnit": {
            "state": "translated",
            "value": "Hold and press Tab to pick a window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住连按 Tab 一扇一扇地挑，松手切过去；收着的窗口也在里面。选 ⌘Tab 会换掉系统的 App 切换"
          }
        }
      }
    },
    "settings.browser.defaultLayout.name": {
