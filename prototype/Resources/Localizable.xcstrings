    "settings.input.fourFinger.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four-finger tap opens hidden windows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "四指轻点打开看不见的窗口"
