    "habit.closeTab.sub": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不会跟着退出，退出按 ⌘Q"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app stays open. To quit, press ⌘Q"
          }
        }
      }
    },
