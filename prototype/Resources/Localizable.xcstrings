    "privacy.remote-hid.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode; only the mappings it took are restored on quit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式；退出时只还原自己占用的映射"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控模式；退出時只還原自己佔用的對映"
          }
        }
      }
    },
    "privacy.remote-lan.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Announces and accepts connections only after Remote mode is on; off by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式打开之后才宣告、接受连接；默认关"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控模式開啟之後才宣告、接受連線；預設關"
          }
        }
      }
    },
    "privacy.remote-lan.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote connections show when you're driving this Mac from an iPhone on the same network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控连接合起来，能看出你什么时候在用 iPhone 遥控这台 Mac、在同一个网络里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控連接合起來，能看出你什麼時候在用 iPhone 遙控這台 Mac、在同一個網路裡。"
          }
        }
      }
    },
    "privacy.remote-lan.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this local network only; nothing uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在这个局域网里；不上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在這個區域網路裡；不上傳"
          }
        }
      }
    },
    "privacy.remote-lan.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone remote's local connection to this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上的遥控器的本地连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上的遙控器的本地連線"
          }
        }
      }
    },
    "privacy.remote-lan.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets an iPhone work as a remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 iPhone 当遥控器用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 iPhone 當遙控器用"
          }
        }
      }
    },
    "privacy.remote-lan.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection state, key and touch commands from the remote app on an iPhone on the same local network; other devices aren't read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个局域网里 iPhone 上的遥控器发来的连接状态和按键、触摸指令；不读别的设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一個區域網路裡 iPhone 上的遙控器發來的連線狀態和按鍵、觸控指令；不讀別的裝置"
          }
        }
      }
    },
    "privacy.remote-lan.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone as a remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 当遥控器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 當遙控器"
          }
        }
      }
    },
    "privacy.remote-lan.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode; turning it off stops announcing, disconnects and stops listening"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遥控模式；关掉就停止宣告、断开并停止监听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遙控模式；關掉就停止宣告、中斷連線並停止監聽"
          }
        }
      }
    },
    "privacy.remote-touch.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the coordinate source is confirmed; without coordinates only buttons are used"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认过坐标来源之后；没有坐标就只用按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認過座標來源之後；沒有座標就只用按鈕"
          }
        }
      }
    },
    "privacy.remote-touch.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch paths show how you use the remote, including the gestures you reach for."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触摸轨迹合起来，能看出你怎么用遥控器，包括惯用的手势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸控軌跡合起來，能看出你怎麼用遙控器，包括慣用的手勢。"
          }
        }
      }
    },
    "privacy.remote-touch.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the current stroke, at most 2048 points"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只留当前这一笔，最多 2048 个点"
          }
        },
