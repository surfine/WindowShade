        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "碰一下就不鎖"
          }
        }
      }
    },
    "privacy.agent-hooks.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After turning on Coding sessions and pasting the configuration into Claude Code; off by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“编程会话”、把配置粘贴进 Claude Code 之后；默认关"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟“程式設計工作階段”、把設定貼上進 Claude Code 之後；預設關"
          }
        }
      }
    },
    "privacy.agent-hooks.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding assistant events show which project you're on and when you write code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编程助手的事件合起来，能看出你在做哪个项目、什么时候在写代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程式設計助手的事件合起來，能看出你在做哪個專案、什麼時候在寫程式碼。"
          }
        }
      }
    },
    "privacy.agent-hooks.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrives over a local connection on this Mac, not the internet; in memory, forgotten when switched off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只经这台 Mac 上的本机连接收，不联网；只在内存里，关掉就忘"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只經這台 Mac 上的本機連線收，不聯網；只在記憶體裡，關掉就忘"
          }
        }
      }
    },
    "privacy.agent-hooks.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding assistant events"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编程助手的事件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程式設計助手的事件"
          }
        }
      }
    },
    "privacy.agent-hooks.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows whether Claude Code is running or waiting for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海里看 Claude Code 在跑还是在等你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏海里看 Claude Code 在跑還是在等你"
          }
        }
      }
    },
    "privacy.agent-hooks.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code session ids, folder names, tool names in use and events, and which terminal it runs in (terminal app name, pane id, terminal device name) so one click can jump back to that terminal; command contents and conversations are not read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 的会话编号、所在文件夹的名字、正在用的工具名和事件，以及它跑在哪个终端里（终端 App 名、窗格编号、终端设备名），用来一键跳回那个终端；不读命令内容和对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 的工作階段編號、所在資料夾的名字、正在用的工具名和事件，以及它跑在哪個終端機裡（終端機 App 名、窗格編號、終端機裝置名），用來一鍵跳回那個終端機；不讀命令內容和對話"
          }
        }
      }
    },
    "privacy.agent-hooks.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the coding assistant's state in the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编程助手的状态放到刘海"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程式設計助手的狀態放到瀏海"
          }
        }
      }
    },
    "privacy.agent-hooks.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding sessions (in Conductor's settings); turning it off stops receiving and drops the local connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编程会话（在指挥模式设置里）；关掉就停止接收，删掉本机连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程式設計工作階段（在指揮模式設定裡）；關掉就停止接收，刪掉本機連線"
          }
        }
      }
    },
    "privacy.agent-voice-proof.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only after the approval has been shown and you confirm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经展示了审批、你又确认之后才发起"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經展示了審批、你又確認之後才發起"
          }
        }
      }
    },
    "privacy.agent-voice-proof.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound of the approval phrase, taken together, can tell whether it's your voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批口令的声音合起来，能辨认这是不是你的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審批口令的聲音合起來，能辨認這是不是你的聲音。"
          }
        }
      }
    },
    "privacy.agent-voice-proof.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept briefly in memory for this one request; no full recording log"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短期留在内存里，只对应这一次请求；不写完整的录音日志"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短期留在記憶體裡，只對應這一次請求；不寫完整的錄音日誌"
          }
        }
      }
    },
    "privacy.agent-voice-proof.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval passphrases and voice hints"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批口令和声纹辅助证据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審批口令和聲紋輔助證據"
          }
        }
      }
    },
    "privacy.agent-voice-proof.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A supporting hint for high-risk actions; not a permission by itself"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高风险操作的辅助证据；它本身不是放行的权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高風險操作的輔助證據；它本身不是放行的權限"
          }
        }
      }
    },
    "privacy.agent-voice-proof.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcription of one random passphrase, and the result of the supporting check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次随机口令的转写，和辅助比对的结果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次隨機口令的轉寫，和輔助比對的結果"
          }
        }
      }
    },
    "privacy.agent-voice-proof.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passphrase for high-risk actions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高风险操作的辅助口令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高風險操作的輔助口令"
          }
        }
      }
    },
    "privacy.agent-voice-proof.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no reliable voiceprint the usual identity path is used"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可靠的声纹时，沿用现有的主身份路径"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可靠的聲紋時，沿用現有的主身份路徑"
          }
        }
      }
    },
    "privacy.airdrop-send.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when you drop on AirDrop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你松在“隔空投送”上时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你松在“AirDrop”上時"
          }
        }
      }
    },
    "privacy.airdrop-send.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All that's known is that you handed something over and whether it worked — not who received it, and no filename is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只知道你投过东西、成没成，不知道发给了谁，也不留文件名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只知道你投過東西、成沒成，不知道發給了誰，也不留檔名。"
          }
        }
      }
    },
    "privacy.airdrop-send.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed to the system's AirDrop; we don't see who received it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交给系统的隔空投送；我们不知道发给了谁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交給系統的AirDrop；我們不知道發給了誰"
          }
        }
      }
    },
    "privacy.airdrop-send.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you hand to AirDrop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交给隔空投送的东西"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交給AirDrop的東西"
          }
        }
      }
    },
    "privacy.airdrop-send.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands files straight to nearby devices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把文件直接投给附近的设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把檔案直接投給附近的裝置"
          }
        }
      }
    },
    "privacy.airdrop-send.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only hands things over, reads nothing; all that's known is whether it worked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只交出去，不读；只知道成没成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只交出去，不讀；只知道成沒成"
          }
        }
      }
    },
    "privacy.airdrop-send.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands things to AirDrop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把东西交给隔空投送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把東西交給AirDrop"
          }
        }
      }
    },
    "privacy.airdrop-send.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switch of its own"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有单独的开关"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有單獨的開關"
          }
        }
      }
    },
    "privacy.app-uninstall.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans only when you pick Uninstall App… in the app's context menu; the switch is off by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在这个 App 的右键菜单里点「卸载 App…」才扫；功能开关默认关"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在這個 App 的右鍵選單裡點「解除安裝 App…」才掃；功能開關預設關"
          }
        }
      }
    },
    "privacy.app-uninstall.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The uninstall file list together shows what this app left behind on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载的文件清单合起来，能看出这个 App 在这台 Mac 上留下过什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝的檔案清單合起來，能看出這個 App 在這台 Mac 上留下過什麼。"
          }
        }
      }
    },
    "privacy.app-uninstall.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list shows only in the uninstall panel; files go to the Trash, nothing is uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清单只在卸载浮层里给你看；文件进废纸篓，不上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清單隻在解除安裝浮層裡給你看；檔案進垃圾桶，不上傳"
          }
        }
      }
    },
    "privacy.app-uninstall.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Related files seen when uninstalling an app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载 App 时读到的关联文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝 App 時讀到的關聯檔案"
          }
        }
      }
    },
    "privacy.app-uninstall.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves the app and its related files to the Trash (recoverable)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 App 和它的关联文件一起移到废纸篓（可找回）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 App 和它的關聯檔案一起移到垃圾桶（可找回）"
          }
        }
      }
    },
    "privacy.app-uninstall.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list of user-domain files belonging to the app you're uninstalling (preferences, application support, caches, window state, containers, launch agents and the like) and their sizes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你右键要卸载的那个 App 的用户域关联文件清单（偏好、应用支持、缓存、窗口状态、容器、启动代理等）和它们的大小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你右鍵要解除安裝的那個 App 的使用者域關聯檔案清單（偏好、應用支援、快取、視窗狀態、容器、啟動代理等）和它們的大小"
          }
        }
      }
    },
    "privacy.app-uninstall.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalling takes its files to the Trash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删 App 连文件进废纸篓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪 App 連檔案進垃圾桶"
          }
        }
      }
    },
    "privacy.app-uninstall.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Launchpad uninstall switch; each run asks for a tick, and unticked items are left alone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动台卸载的开关；每次还有勾选确认，不勾的不动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動台解除安裝的開關；每次還有勾選確認，不勾的不動"
          }
        }
      }
    },
    "privacy.audio-outputs.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current device type is read once when the card opens; everything is read when you pick Play to; no permanent listener and no timers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开正在播放的大卡时读一次当前设备的类型；点“播放到”时读一次全部；没有常驻监听，不定时去读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟正在播放的大卡時讀一次當前裝置的型別；點“播放到”時讀一次全部；沒有常駐監聽，不定時去讀"
          }
        }
      }
    },
    "privacy.audio-outputs.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device names together show which headphones and speakers you own, some carrying your name; never what you're listening to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设备名合起来，能看出你有哪些耳机和音箱，有的还带着你的名字；看不出你在听什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的裝置名合起來，能看出你有哪些耳機和揚聲器，有的還帶著你的名字；看不出你在聽什麼。"
          }
        }
      }
    },
    "privacy.audio-outputs.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In memory; device names stay out of the logs; picking one only switches the system's default output"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在内存里，设备名不写进运行记录，不发送；你选定后，只把系统默认输出换成那一个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在記憶體裡，裝置名不寫進執行記錄，不傳送；你選定後，只把系統預設輸出換成那一個"
          }
        }
      }
    },
    "privacy.audio-outputs.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound output devices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音输出设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聲音輸出裝置"
          }
        }
      }
    },
    "privacy.audio-outputs.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks where sound comes out in the Now Playing card, and tells headphones, speakers and this Mac apart by icon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在正在播放的大卡上，选声音从哪里出来，并按图标认出现在用的是耳机、音箱还是这台 Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在正在播放的大卡上，選聲音從哪裡出來，並按圖示認出現在用的是耳機、揚聲器還是這台 Mac"
          }
        }
      }
    },
    "privacy.audio-outputs.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and types of the output devices offered in the system's Sound settings, and which one is current; device names may carry your name, like “Alex's AirPods”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统“声音”里能选的输出设备的名字、类型和哪一个是当前的；设备名里可能有你的名字，比如“小明的 AirPods”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統“聲音”裡能選的輸出裝置的名字、型別和哪一個是當前的；裝置名裡可能有你的名字，比如“小明的 AirPods”"
          }
        }
      }
    },
    "privacy.audio-outputs.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick where the sound comes out, in the card"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大卡里选声音从哪里出来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大卡里選聲音從哪裡出來"
          }
        }
      }
    },
    "privacy.audio-outputs.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Now Playing off in Settings and the card won't open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置里的“正在播放”关掉，大卡就不会开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定裡的“正在播放”關掉，大卡就不會開"
          }
        }
      }
    },
    "privacy.authorization-key.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each time you explicitly approve; locking and the like void older approvals"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次你明确授权时；锁屏等情况会让旧的授权作废"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次你明確授權時；鎖定畫面等情況會讓舊的授權作廢"
          }
        }
      }
    },
    "privacy.authorization-key.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often and when the authorization key is used shows when you've approved things."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权密钥的使用次数和时间合起来，能看出你什么时候批准过操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權金鑰的使用次數和時間合起來，能看出你什麼時候批准過操作。"
          }
        }
      }
    },
    "privacy.authorization-key.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In WindowShade's authorization folder on this Mac, not the keychain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放在这台 Mac 上 WindowShade 的授权文件夹里，没有写进钥匙串"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放在這台 Mac 上 WindowShade 的授權資料夾裡，沒有寫進鑰匙串"
          }
        }
      }
    },
    "privacy.authorization-key.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device authorization keys"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备授权密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置授權金鑰"
          }
        }
      }
    },
    "privacy.authorization-key.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each approval covers one thing and is valid once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次授权只对一件事、只有一次有效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次授權只對一件事、只有一次有效"
          }
        }
      }
    },
    "privacy.authorization-key.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The public half of a key the Mac's security chip protects, the result of its use, and a one-off challenge; the private key can't be exported"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 安全芯片保护的密钥的公钥、使用结果和一次性的挑战；私钥导不出来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 安全晶片保護的金鑰的公鑰、使用結果和一次性的挑戰；私鑰導不出來"
          }
        }
      }
    },
    "privacy.authorization-key.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each approval covers one thing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次授权只管一件事"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次授權只管一件事"
          }
        }
      }
    },
    "privacy.authorization-key.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the record; the safety check can't be skipped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除登记；安全校验不能跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除登記；安全校驗不能跳過"
          }
        }
      }
    },
    "privacy.battery.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this Mac's power changes (pushed, no more polling), and when an accessory connects or disconnects; connected accessories are read every 2 minutes; AirPods are read once when they become the output and at most every 10 minutes after"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的电源变化时（系统推送，不再定时读）；配件连上、断开时；已连着的配件每 2 分钟读一次；AirPods 成为声音输出时读一次，之后最多 10 分钟一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 的電源變化時（系統推播，不再定時讀）；配件連上、中斷連線時；已連著的配件每 2 分鐘讀一次；AirPods 成為聲音輸出時讀一次，之後最多 10 分鐘一次"
          }
        }
      }
    },
    "privacy.battery.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory models and battery together show which accessories you use and how long since they were charged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配件的型号和电量合起来，能看出你用哪些配件、多久没充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配件的型號和電量合起來，能看出你用哪些配件、多久沒充電。"
          }
        }
      }
    },
    "privacy.battery.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery stays in memory; a warned low battery is remembered on this Mac to avoid repeating"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量只在内存里用；提醒过的低电量记在这台 Mac 的设置里，免得重复提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電量只在記憶體裡用；提醒過的低電量記在這台 Mac 的設定裡，免得重複提醒"
          }
        }
      }
    },
    "privacy.battery.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory battery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配件电量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配件電量"
          }
        }
      }
    },
    "privacy.battery.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notch says a word when an accessory connects or runs low"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配件连上或电量低时，刘海说一句"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配件連上或電量低時，瀏海說一句"
          }
        }
      }
    },
    "privacy.battery.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac's battery level, whether it's plugged in, whether it's full and Low Power Mode; names and battery levels of connected accessories; with AirPods connected to this Mac, the levels of the left bud, right bud and case"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的电量、有没有插电、是否已充满、低电量模式；已连接配件的名字和电量；AirPods 连在这台 Mac 上时，读左耳、右耳、充电盒的电量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 的電量、有沒有插電、是否已充滿、低電量模式；已連線配件的名字和電量；AirPods 連在這台 Mac 上時，讀左耳、右耳、充電盒的電量"
          }
        }
      }
    },
    "privacy.battery.subtitle": {
      "extractionState": "manual",
      "localizations": {
