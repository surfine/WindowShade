    "settings.input.mouseDirection.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the mouse's scrolling is changed. While the app can't tell which mouse an event came from, nothing is changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只准备改鼠标的滚动。还不能确认事件来自哪只鼠标时，先不改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只准備改滑鼠的捲動。還不能確認事件來自哪隻滑鼠時，先不改。"
          }
        }
      }
    },
    "settings.input.mouseDirection.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse scroll direction"
          }
        },
        "zh-Hans": {
