            "value": "不填接收器地址就只看示意画面；清掉地址即不连"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不填接收器地址就只看示意畫面；清掉地址即不連"
          }
        }
      }
    },
    "privacy.codex-server.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read only while bound to a session; the first connection takes the current state once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在绑定会话时读；第一次连上先取一次现状"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在繫結工作階段時讀；第一次連上先取一次現狀"
          }
        }
      }
    },
    "privacy.codex-server.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex's sessions and approvals together show what you're working on and what you've approved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 的会话和审批合起来，能看出你在做什么项目、批准过哪些操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 的工作階段和審批合起來，能看出你在做什麼專案、批准過哪些操作。"
          }
        }
      }
    },
    "privacy.codex-server.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local service on this Mac; later Codex calls may send what you submit to the provider"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的本机服务；之后的 Codex 调用可能把你提交的内容发给提供商"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 上的本機服務；之後的 Codex 呼叫可能把你提交的內容發給提供商"
          }
        }
      }
    },
    "privacy.codex-server.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex sessions and approvals"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 会话和审批"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 工作階段和審批"
          }
        }
      }
    },
    "privacy.codex-server.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends what you explicitly submit and shows the real receipt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送你明确提交的内容，并显示真实的回执"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送你明確提交的內容，並顯示真實的回執"
          }
        }
      }
    },
    "privacy.codex-server.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available models, session and approval-request states, the quota a session reports (how much is left, when it resets), and the least text you submit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用的模型、会话和审批请求的状态，会话自己报来的额度（还剩多少、什么时候恢复），以及你提交的最少文字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用的模型、工作階段和審批請求的狀態，工作階段自己報來的額度（還剩多少、什麼時候回復），以及你提交的最少文字"
          }
        }
      }
    },
    "privacy.codex-server.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends what you submit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送你提交的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送你提交的內容"
          }
        }
      }
    },
    "privacy.codex-server.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor ties to one session; it doesn't read arbitrary history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥模式和会话绑定；不读任意的历史全文"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指揮模式和工作階段繫結；不讀任意的歷史全文"
          }
        }
      }
    },
    "privacy.command-review.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the assistant asks; it expires after 30 seconds or on disconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手提出请求时；30 秒后或断线就失效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助手提出請求時；30 秒後或斷線就失效"
          }
        }
      }
    },
    "privacy.command-review.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full commands and the working directory together show which project you're on and what you changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整命令和工作目录合起来，能看出你在做哪个项目、改了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整命令和工作目錄合起來，能看出你在做哪個專案、改了什麼。"
          }
        }
      }
    },
    "privacy.command-review.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local authentication and authorization records on this Mac; no command log"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的本机认证和授权记录；不写命令日志"
