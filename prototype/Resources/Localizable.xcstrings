      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More see-through, so what's behind shows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让它更透一些，能看到后面的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓它更透一些，能看到後面的內容"
          }
        }
      }
    },
