    "settings.remote.gamepad.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "D-pad to move, × to confirm, ○ to go back, △ to return to the notch row (hold half a second for Launchpad), Options to play or pause. When a game is in front, the controller steps aside."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用十字键选，× 确认，○ 返回，△ 回到刘海那一排（按住 0.5 秒打开启动台），Options 播放或暂停。游戏在前台时手柄整个让开。"
          }
        }
      }
    },
