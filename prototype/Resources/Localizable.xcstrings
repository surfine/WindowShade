      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files you drag to the notch wait on the shelf. Click a Dock icon again to move that app out of the way."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖到刘海的文件放进文件架；再点一下 Dock 图标，让开这个 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖到瀏海的檔案放進檔案架；再點一下 Dock 圖示，讓開這個 App。"
          }
        }
      }
