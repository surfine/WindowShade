    "settings.shade.splitHandle.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When two windows fill a screen, drag the bar between them to resize both; push it to the edge to send one into Slide Over"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两扇窗口拼满一块屏时，中间出现一根小竖条：拖它两扇一起变，推到屏幕边那一扇进侧拉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩扇視窗拼滿一塊螢幕時，中間出現一根小豎條：拖它兩扇一起變，推到螢幕邊那一扇進側拉"
          }
        }
      }
    },
    "settings.shade.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How windows roll up, how a rolled-up window looks, and whether to play a sound."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置怎么收起窗口、收起后什么样、要不要提示音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定怎麼收起視窗、收起後什麼樣、要不要提示音。"
          }
        }
      }
    },
