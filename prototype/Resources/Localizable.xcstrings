            "value": "這台 Mac 上的本機驗證和授權記錄；不寫命令日誌"
          }
        }
      }
    },
    "privacy.command-review.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command approvals"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令审批"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "命令審批"
          }
        }
      }
    },
    "privacy.command-review.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approves this one command once; file and rule approvals are separate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只批准这一条命令一次；文件和规则的审批另算"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只批准這一條命令一次；檔案和規則的審批另算"
          }
        }
      }
    },
    "privacy.command-review.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete commands, the working directory, session context and a one-off review snapshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的命令、工作目录、会话背景和一次性的审阅快照"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的命令、工作目錄、工作階段背景和一次性的審閱快照"
          }
        }
      }
    },
    "privacy.command-review.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approves one command at a time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准一条命令一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批准一條命令一次"
          }
        }
      }
    },
    "privacy.command-review.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval appears only when it's asked for; it can't be skipped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批只在有请求时出现；不能跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審批只在有請求時出現；不能跳過"
          }
        }
      }
    },
    "privacy.conductor-audio.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Conductor on and the side button held"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥模式打开，并且按住侧边按钮时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指揮模式開啟，並且按住側邊按鈕時"
          }
        }
      }
    },
    "privacy.conductor-audio.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound while you hold, taken together, shows what you said and may reveal whether it was you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住时的声音合起来，能看出你说了什么，也可能听出是不是你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住時的聲音合起來，能看出你說了什麼，也可能聽出是不是你。"
          }
        }
      }
    },
    "privacy.conductor-audio.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不读取"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不讀取"
          }
        }
      }
    },
    "privacy.conductor-audio.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound while the side button is held"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住侧边按钮时的声音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住側邊按鈕時的聲音"
          }
        }
      }
    },
    "privacy.conductor-audio.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let go to get a draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开后得到草稿"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬆開後得到草稿"
          }
        }
      }
    },
    "privacy.conductor-audio.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound while the side button is held; the transcription is discarded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住侧边按钮时的声音；转写后丢弃"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住側邊按鈕時的聲音；轉寫後丟棄"
          }
        }
      }
    },
    "privacy.conductor-audio.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold and speak to get a draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话得到草稿"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住說話得到草稿"
          }
        }
      }
    },
    "privacy.conductor-audio.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指揮模式"
          }
        }
      }
    },
    "privacy.conductor-ipc.activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you explicitly bind it; locking, sleeping or undoing ends it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你明确绑定之后；锁屏、睡眠、撤销都会关掉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你明確綁定之後；鎖定畫面、睡眠、取消都會關掉"
          }
        }
      }
    },
    "privacy.conductor-ipc.combined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor connections show which project and which session you're conducting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥连接合起来，能看出你在指挥哪个项目、哪段会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指揮連接合起來，能看出你在指揮哪個專案、哪段工作階段。"
          }
        }
      }
    },
    "privacy.conductor-ipc.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passed within this Mac; it doesn't listen on the network by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在这台 Mac 里传递；默认不在局域网里监听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在這台 Mac 裡傳遞；預設不在區域網路裡監聽"
          }
        }
      }
    },
    "privacy.conductor-ipc.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductor connections"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指挥连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指揮連線"
          }
        }
      }
    },
    "privacy.conductor-ipc.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ties input to the assistant session on this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把输入和这台 Mac 上的助手会话绑在一起"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把輸入和這台 Mac 上的助手工作階段綁在一起"
          }
        }
      }
    },
    "privacy.conductor-ipc.reads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other side's identity in the same account, project and session ids, and a request summary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一账户里对方的身份、项目和会话编号、请求摘要"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一帳戶裡對方的身份、專案和工作階段編號、請求摘要"
          }
        }
      }
    },
    "privacy.conductor-ipc.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ties the input to the assistant session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定输入和助手会话"
          }
        },
