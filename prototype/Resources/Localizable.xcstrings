{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "habit.closeTab.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app stays open. To quit, press ⌘Q"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不会跟着退出，退出按 ⌘Q"
          }
        }
      }
    },
    "habit.closeTab.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is ⌘W"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@按 ⌘W"
          }
        }
      }
    },
    "habit.closeWindow.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To quit the whole app, press ⌘Q"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出整个 App 按 ⌘Q"
