      <title>1.0.22</title>
      <pubDate>Mon, 16 Nov 2026 01:01:34 +0000</pubDate>
      <sparkle:version>20261115.01</sparkle:version>
      <sparkle:shortVersionString>1.0.22</sparkle:shortVersionString>
